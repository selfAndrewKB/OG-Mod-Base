(define-perm *target* target #f)

;; co-op: list of handles for all player targets (index 0 = *target*, 1-3 = extra players)
(define *target-list* (new 'global 'boxed-array handle 4))

(defun get-target ((tgt-idx int))
  "Return the target process at the given index, or #f if slot is empty."
  (if (zero? (-> *target-list* tgt-idx))
    (the-as target #f)
    (the-as target (handle->process (-> *target-list* tgt-idx)))
    )
  )

;; Co-op singleton helpers: many vanilla doors/platforms asked only *target*
;; whether P1 had eco. Keep the target-list scan centralized so level scripts
;; can ask "which nearby player is eligible?" without open-coding handle guards.
(defun target-has-powerup? ((tgt target) (kind pickup-type))
  "Return true when this target currently owns the requested eco powerup."
  (and (= (-> tgt fact eco-type) kind) (< 0.0 (-> tgt fact eco-level))))

;; Returns the owning target so callers can also route owner-specific effects
;; like blue projectiles or launches to the player that actually powered it.
(defun target-with-powerup-near ((pos vector) (dist float) (kind pickup-type))
  "Find any active target near pos that currently owns the requested eco powerup."
  (dotimes (idx (-> *target-list* length))
    (let ((tgt (get-target idx)))
      (when (and tgt
                 (>= dist (vector-vector-distance pos (-> tgt control trans)))
                 (target-has-powerup? tgt kind))
        (return tgt))))
  (the-as target #f))

;; Non-powerup proximity companion for hints/autoclose logic. Prefer this over
;; *target* distance checks when any player should keep a mechanism awake/open.
(defun target-near ((pos vector) (dist float))
  "Find any active target near pos."
  (dotimes (idx (-> *target-list* length))
    (let ((tgt (get-target idx)))
      (when (and tgt (>= dist (vector-vector-distance pos (-> tgt control trans))))
        (return tgt))))
  (the-as target #f))

;; Shared low-level rider helpers for co-op platforms. Detection/carrying still
;; stays in the engine's native rider path; these only inspect that rider state.
(defun platform-target-riding? ((riders collide-sticky-rider-group) (tgt target))
  "Return true when tgt is one of the platform's currently detected riders."
  (dotimes (idx (-> riders num-riders))
    (let ((rider-h (-> riders rider idx rider-handle)))
      ;; handle->process is unsafe on zero handles; keep the guard at the call.
      (when (not (zero? rider-h))
        (let ((rider-proc (handle->process rider-h)))
          (when (and rider-proc (= rider-proc tgt))
            (return #t))))))
  #f)

(defun target-active-for-platform-sync? ((tgt target))
  "Return true when this target can be safely included in platform sync helpers."
  ;; Dead/loading targets can still have a live process handle during respawn.
  ;; Skip them for explicit platform assists; native respawn/continue should own
  ;; their position until they are back in normal control.
  (and (nonzero? (-> tgt state))
       (!= (-> tgt next-state name) 'target-death)
       (!= (-> tgt next-state name) 'target-load-wait)
       (!= (-> tgt next-state name) 'target-continue)
       (!= (-> tgt next-state name) 'target-warp-in)
       (!= (-> tgt next-state name) 'target-warp-out)))

(defun platform-teleport-active-targets! ((platform-pos vector) (y-offset float) (spacing float))
  "Move every active player to platform-pos, spread along X for collision safety."
  ;; This is intentionally an explicit, case-by-case assist rather than a hidden
  ;; platform policy. Use it only for one-shot platforms where leaving a player
  ;; behind is worse than snapping them onto the carrier.
  (let ((slot 0))
    (dotimes (idx (-> *target-list* length))
      (let ((tgt (get-target idx)))
        (when (and tgt (target-active-for-platform-sync? tgt))
          (let ((dst (new 'stack-no-clear 'vector))
                (delta (new 'stack-no-clear 'vector)))
            (set! (-> dst quad) (-> platform-pos quad))
            (set! (-> dst x) (+ (-> dst x) (* spacing (the float (- slot 1)))))
            (set! (-> dst y) (+ (-> dst y) y-offset))
            (vector-! delta dst (-> tgt control trans))
            (move-by-vector! (-> tgt control) delta)
            (set! (-> tgt control transv quad) (the-as uint128 0))
            (send-event tgt 'reset-height)
            (set! slot (+ slot 1))))))))

(deftype sidekick (process-drawable)
  ((parent-override  (pointer target) :overlay-at parent)
   (control          control-info :overlay-at root)
   (anim-seed        uint64 :offset 192)
   (shadow-in-movie? symbol))
  (:states
   sidekick-clone))

(define-perm *sidekick* sidekick #f)

(defun-extern start symbol continue-point target)

(defun-extern stop symbol int)

(define-extern do-target-shadow (function none :behavior target))

(define-extern target-joint-pos (function vector))

(define-extern target-cam-pos (function vector))

(define-extern target-powerup-process (function none :behavior target))

(define-extern target-exit (function none :behavior target))

(define-extern target-generic-event-handler (function process int symbol event-message-block object :behavior target))

(define-extern init-sidekick (function none :behavior sidekick))

(define-extern racer-collision-reaction
  (function control-info collide-shape-intersect vector vector cshape-moving-flags))

(define-extern start-sequence-a (function none))
