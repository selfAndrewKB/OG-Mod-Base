;;-*-Lisp-*-
(in-package goal)

;; Forward declaration — target-alive? is defined in engine/mods/localmulti.gc
;; which compiles after this file. We only need its signature here.
(define-extern target-alive? (function target basic))
;; Forward declaration — fp-hud-spawn-for-pass is defined in engine/target/target2.gc
;; which compiles after this file. Calls spawn-particles! on the fp-hud for pass PASS
;; using the already-correct *math-camera* for that pass.
(define-extern fp-hud-spawn-for-pass (function int none))
;; Forward declaration — hud-draw-for-pass is defined in engine/ui/hud-classes.gc.
;; Reads *hud-parts-list* slots[pass] and calls draw-particles + draw-hud per HUD.
;; Each HUD's owner is the spawning target (parent process).
(define-extern hud-draw-for-pass (function int none))

;; Forward declaration — multi-log-enabled? lives in engine/mods/multi-debug.gc
;; (GAME.CGO, compiles after this file). Used by the Session 20 draw diagnostic.
(define-extern multi-log-enabled? (function symbol symbol))
(define-extern *fuel-cell-racer-victory-presentation-active* symbol)

;; *camera-p2* is defined in ENGINE.CGO cam-start.gc. Forward-declared here so
;; split-screen-should-render? can read the tracked-target readiness field.
(define-extern *camera-p2* camera-master)

;; name: multi-draw.gc
;; name in dgo: multi-draw
;; dgos: GAME

;; Phase 3F — Native dual-camera draw pipeline.
;;
;; The entire GOAL draw pipeline runs twice per frame with *math-camera*
;; swapped between P1 and P2. Every GOAL culling system (BSP traversal,
;; frustum tests, vis-cells, draw-nodes) reads *math-camera* and thus
;; operates correctly for whichever camera is active in that pass.
;;
;; dma-bucket-insert-tag shifts its effective bucket index by
;; *active-render-cam* * BUCKET_COUNT, so P2's DMA lands in the second half
;; of the bucket array. C++ dispatch_buckets_jak1 auto-detects dual-pass by
;; checking if the second half was written to, and dispatches each half to
;; its own viewport.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Globals
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; P2's full math-camera state, persistent across frames.
(define *p2-math-camera* (new 'global 'math-camera))

;; Scratch save slot for P1 while pass 2 runs, so we can restore it for
;; post-draw code (HUD, actors-update, cutscene reads).
(define *math-camera-backup* (new 'global 'math-camera))

;; Phase 3G: indirection pointer for update-camera's output. Each cam-master
;; sets this to its own output-cam at the top of its code loop. cam-update.gc
;; writes update-camera() results to whatever this currently points at.
;; In single-player this is always *math-camera*. In split-screen, cam-master-P2
;; swaps it to *p2-math-camera* while its processes run.
(define *cam-out* *math-camera*)

;; Phase 3G.2 Session B: *camera-p2* and *camera-combiner-p2* are defined in
;; cam-start.gc (load-order reason — cam-start's top-level (cam-start #f) call
;; touches them via cam-stop at startup). cam-master-init / cam-combiner-init
;; populate them when spawned with pad-idx = 1 from localmulti.gc.

;; 0 during pass 1 (P1), 1 during pass 2 (P2). Read by dma-bucket-insert-tag
;; to offset bucket indices into the second half of the bucket array.
(define *active-render-cam* 0)

;; Phase 3G.2 Session 22: vis-bits save/merge buffers.
;; level-group has at most 3 levels; each level's vis-buffer is ≤2048 bytes
;; (128 uint128 quad-words). Layout: level i stored at byte offset i*2048.
;; *p1-vis-save* — P1's vis-bits saved BEFORE P2's update-visible overwrites them.
;; *p2-vis-save* — P2's vis-bits saved AFTER P2's draw pass.
;; After both passes vis-bits are forcefully set to P1|P2 so actors-update
;; sees entities visible to either player.
;;
;; GOAL's new 'global 'inline-array doesn't accept primitive types, so we wrap
;; the raw bytes in a simple structure. 3 levels × 2048 bytes = 6144 bytes.
(deftype vis-save-buf (structure)
  ((data uint8 6144)))

(define *p1-vis-save* (new 'global 'vis-save-buf))
(define *p2-vis-save* (new 'global 'vis-save-buf))

;; Tracks the previous frame's split-screen-should-render? result so the
;; transition log fires exactly once on re-activation (not every frame).
(define *split-screen-prev-active* #f)
(define *split-screen-presentation-lock-active* #f)

(define-extern process-taskable-release-coop-targets-from-split-screen! (function none))

(defun split-screen-presentation-blocked? ()
  ;; Block split-screen only for camera-locking presentations:
  ;;   real-movie? — POV cutscene cameras (checks *game-info* movie)
  ;;   movie?      — spool-based cutscenes and tutorial hints (these also set movie?)
  ;;   othercam    — NPC talk sequences, fuel-cell victory cameras
  ;;
  ;; NOTE: spooling is intentionally excluded. The spooling setting fires for ANY
  ;; streaming audio event including ambient NPC idle dialogue, which has no
  ;; camera lockout. Including it caused P2 to flicker invisible on every ambient
  ;; voice line. real-movie? + movie? + othercam covers all actual lockout cases.
  ;;
  ;; Exception: Misty's airborne racer fuel cell (`fuel-cell-racer-victory-1`) is
  ;; authored around the rider who actually grabs it. If P2 grabs it, the fuel-cell
  ;; code routes the movie subject to P2; the generic "hide and grab-lock P2 while
  ;; othercam is active" rule would hide the very actor the movie is trying to show.
  ;; Keep this exception as a direct flag from that fuel-cell path, not a broad
  ;; vehicle/cutscene rule.
  (let ((cam-handle (-> *game-info* other-camera-handle)))
    (and (not *fuel-cell-racer-victory-presentation-active*)
         (or (real-movie?)
             (-> *setting-control* current movie)
             (and (not (zero? cam-handle)) (handle->process cam-handle))))))

;; coop: player-query (P2 alive gates split-screen)
(defun split-screen-render-ready? ()
  (let ((cam-handle (-> *game-info* other-camera-handle)))
    (if (and (target-alive? (get-target 1))
             (not (real-movie?))
             (not (paused?))
             (or (zero? cam-handle) (not (handle->process cam-handle)))
             *camera-p2*
             (nonzero? (-> *camera-p2* tracked-target)))
      #t
      #f)))

(defun split-screen-update-presentation-lock! ()
  ;; Architecture: responsibility split between draw hook (this fn) and
  ;; localmulti-run-eachframe.
  ;;
  ;; DRAW HOOK (here): set the hidden bit on P2 EVERY frame while blocked.
  ;; This is a direct bit-write — safe in the draw hook context (post-dispatch).
  ;; dma-add-process-drawable checks this bit during foreground-engine-execute,
  ;; which runs AFTER this function in the same draw-hook invocation. Setting it
  ;; here also re-hides P2 after any state-transition :exit that called target-exit
  ;; (which clears hidden) during the preceding dispatch.
  ;; IMPORTANT: do NOT call send-event from here — the draw hook runs outside any
  ;; process tick; process state-change events (go target-grab) may longjmp
  ;; in ways that skip subsequent code. Direct bit manipulation is safe; sends are not.
  ;;
  ;; LOCALMULTI (pre-dispatch): reads *split-screen-presentation-lock-active* to
  ;; know when to enforce target-grab (input lock). send-event from that context is
  ;; safe because it fires before execute-math-engine.
  (let ((blocked (split-screen-presentation-blocked?)))
    ;; Hide P2 every frame while a presentation is blocking (idempotent bit-set).
    (when blocked
      (let ((p2-tgt (get-target 1)))
        (when (and p2-tgt (target-alive? p2-tgt))
          (logior! (-> p2-tgt draw status) (draw-status hidden)))))
    ;; Edge detection: signal latch for localmulti's grab/release sends.
    (cond
      ((and blocked (not *split-screen-presentation-lock-active*))
       (when (multi-log-enabled? 'cutscene)
         (let ((p2-tgt (get-target 1)))
           (format 0 "[MULTI:cut]  lock latch SET — blocked=T state=~A~%"
                   (if (and p2-tgt (target-alive? p2-tgt)) (-> p2-tgt state name) 'nil))))
       (set! *split-screen-presentation-lock-active* #t))
      ((and (not blocked) *split-screen-presentation-lock-active*)
       (when (multi-log-enabled? 'cutscene)
         (format 0 "[MULTI:cut]  lock latch CLEARED — blocked=F~%"))
       ;; Do NOT call process-taskable-release-coop-targets-from-split-screen! here.
       ;; That sends 'end-mode (a process state-change event) from the draw hook —
       ;; same unsafe-send problem. localmulti-run-eachframe handles the actual
       ;; 'end-mode when it sees the latch flip to #f next frame.
       (set! *split-screen-presentation-lock-active* #f))))
  (none))

(defun split-screen-force-release-presentation-lock! ()
  ;; Called from NPC `:exit` handlers (sage.gc, sidekick-human.gc) that fire a
  ;; `(start 'play ...)` continue handoff directly — bypassing the normal frame
  ;; where split-screen-presentation-blocked? would return #f organically.
  ;;
  ;; MUST call process-taskable-release here: the NPC cutscene lock path
  ;; (process-taskable-lock-coop-targets-for-presentation!) populated
  ;; *process-taskable-coop-lock-targets* and set *process-taskable-coop-lock-owner*
  ;; to the NPC's handle. Without this release, both survive the level transition
  ;; (owner stays non-zero into training), which was the root cause of the black
  ;; screen on training entry.
  ;;
  ;; NOTE: process-taskable-lock-coop-targets-from-split-screen! (the draw-hook
  ;; variant) is never called in the current architecture — the draw hook only
  ;; bit-writes and latches. Only the NPC-initiated lock path needs releasing here.
  (process-taskable-release-coop-targets-from-split-screen!)
  (set! *split-screen-presentation-lock-active* #f)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Split-screen render predicate
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun split-screen-should-render? ()
  "Return #t when split-screen rendering is appropriate this frame.
   Guards (evaluated in order):
   1. (target-alive? (get-target 1)) — P2's process must be live. Handles the
      save-load path where reset-actors kills P2's process but leaves a non-zero
      stale handle in *target-list* 1. nonzero? alone is not sufficient here.
   2. (not (real-movie?)) — pov-camera cutscenes expect a single full-screen
      viewport. Spool-based tutorial hints also set movie? = #t.
   3. (not (paused?)) — pause/progress menus render full-screen HUD overlays.
   4. *camera-p2* — camera pipeline must exist (nil after cam-stop kills it).
   5. (nonzero? tracked-target) — pipeline must be fully wired. tracked-target
      is nil immediately after cam-start-for-pad; it becomes non-nil only when
      localmulti-run-eachframe sends the 'change-target event. Blocking until
      this is set prevents activate-math-camera!(*p2-math-camera*) from running
      update-visible with stale vis-string pointers that may reference levels
      unloaded during a death/continue sequence (crashes #2 and #3).
   6. (not other-camera-handle) — othercam (fuel-cell victory, NPC cutscenes)
      sets other-camera-handle synchronously in othercam-init-by-other, one
      frame before its :enter sets movie?. This explicit check closes that gap
      and ensures P1-centred cutscenes (orb pickups etc.) always collapse to
      full-screen from the very first frame the othercam process exists.
   Called from: drawable.gc (__pc-set-split-screen-active, dispatch cond,
   display-frame-finish merc/TIE init guard)."
  (let ((result (split-screen-render-ready?)))
    (split-screen-update-presentation-lock!)
    ;; Log the exact frame split-screen re-activates so crash #3 can be
    ;; correlated against warp/camera logs if it persists after these fixes.
    (when (and result (not *split-screen-prev-active*))
      (when (multi-log-enabled? 'draw)
        (format 0 "[MULTI:draw]  split-screen ACTIVE: p2-alive=~A movie=~A paused=~A cam-p2=#x~X tracked=#x~X~%"
                (target-alive? (get-target 1))
                (real-movie?)
                (paused?)
                *camera-p2*
                (if *camera-p2* (-> *camera-p2* tracked-target) 0))))
    ;; (and ...) returns type basic when the chain includes a basic-returning
    ;; function; coerce to symbol so the type matches *split-screen-prev-active*.
    (set! *split-screen-prev-active* (if result #t #f))
    result))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; math-camera blob copy
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun math-camera-copy! ((dst math-camera) (src math-camera))
  "Bulk-copy all fields from src to dst. math-camera contains only inline
   matrices/vectors and primitives (no outbound pointers), and both sides
   have identical type tags, so a raw mem-copy is safe and fast."
  (mem-copy! (the pointer dst) (the pointer src) (size-of math-camera))
  dst)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Movement helpers for secondary targets
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun get-p2-cam-rot-for-movement ()
  "Return *p2-math-camera* inv-camera-rot-smooth for use by P2's read-pad.
   Called from logic-target.gc (ENGINE.CGO) via forward declaration."
  (-> *p2-math-camera* inv-camera-rot-smooth))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; P2 math-camera derivation — DELETED in Phase 3G.2 Session B
;;
;; sync-p2-math-camera-from-p1! was Phase 3F's hand-rolled spring-follow +
;; right-stick yaw/pitch patchwork. Deleted when the native P2 cam-master +
;; cam-combiner pipeline took over. P2's math-camera is now fully computed by
;; update-camera-inner(*camera-combiner-p2*, *p2-math-camera*) in cam-update.gc,
;; driven by P2's own cam-string/cam-stick slave states reading cpad 1.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TIE/Shrub work-struct mirroring
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun sync-instance-work-mirrors-from! ((cam math-camera))
  "Mirror camera-dependent cached fields from cam into *instance-tie-work*
   and *instance-shrub-work*. Must be called whenever the active math-camera
   changes. Mirrors the block in cam-update.gc:382-409."
  (let ((f0 (-> cam fog-min))
        (f1 (-> cam fog-max)))
    (let ((f2 (-> cam d)))
      (set! (-> *instance-tie-work* hmge-d x) f0)
      (set! (-> *instance-tie-work* hmge-d y) f1)
      (set! (-> *instance-tie-work* hmge-d z) (* 32.0 f2))
      (set! (-> *instance-tie-work* hmge-d w) (* f2 (-> cam hmge-scale w)))
      (set! (-> *instance-tie-work* hvdf-offset quad) (-> cam hvdf-off quad))
      (set! (-> *instance-shrub-work* hmge-d x) f0)
      (set! (-> *instance-shrub-work* hmge-d y) f1)
      (set! (-> *instance-shrub-work* hmge-d z) (* 3.0 f2))
      (set! (-> *instance-shrub-work* hmge-d w) (* f2 (-> cam hmge-scale w)))
      (set! (-> *instance-shrub-work* billboard-const x)
            (/ (-> cam x-pix) (* f2 (-> cam x-ratio))))
      (set! (-> *instance-shrub-work* billboard-const y)
            (/ (-> cam y-pix) (* f2 (-> cam y-ratio)))))
    (set! (-> *instance-shrub-work* billboard-const z) f0)
    (set! (-> *instance-shrub-work* billboard-const w) f1))
  (set! (-> *instance-shrub-work* constants w) (the-as float (-> cam vis-gifs 0 fog0)))
  (set! (-> *instance-shrub-work* hvdf-offset quad) (-> cam hvdf-off quad))
  (dotimes (i 4)
    (set! (-> *instance-shrub-work* guard-plane i quad) (-> cam guard-plane i quad))
    (set! (-> *instance-tie-work* guard-plane i quad) (-> cam guard-plane i quad)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Activate a camera for the upcoming draw pass
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun activate-math-camera! ((src math-camera))
  "Swap src into the live *math-camera* slot, refresh all derived work-struct
   mirrors, and recompute visibility. After this call the draw pipeline sees
   src as the primary camera."
  (math-camera-copy! *math-camera* src)
  (sync-instance-work-mirrors-from! *math-camera*)
  (update-visible *math-camera*)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; One draw pass — body extracted from real-main-draw-hook
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun draw-world-pass ()
  "Render one complete view: sky, ocean, background, foreground, bones,
   gmerc, shadow, eyes, sprite. Reads whichever math-camera is currently
   live. Called once in single-player and twice in split-screen."
  ;; Phase 3G.2 Session 20 diagnostic: dump both camera states at the top of
  ;; each pass. Enabled via (set! *multi-dbg-draw* #t) — throttled to every 32
  ;; frames via base-frame-counter low bits to keep log noise manageable.
  ;; Expected when P1 is in cam-circular and P2 is stationary in cam-string:
  ;;   pass=0 should show P1's cam-circular persp/trans (unique values),
  ;;   pass=1 should show P2's cam-string persp/trans (different values),
  ;;   *p2-math-camera* should stay stable between frames.
  (when (and (multi-log-enabled? 'draw)
             (zero? (logand (the-as int (-> *display* base-frame-counter)) #x1f)))
    (format 0 "[MULTI:draw] pass=~D m-cam persp00=~f trans=~f ~f ~f~%"
            *active-render-cam*
            (-> *math-camera* perspective vector 0 x)
            (-> *math-camera* trans x) (-> *math-camera* trans y) (-> *math-camera* trans z))
    (format 0 "[MULTI:draw]        p2    persp00=~f trans=~f ~f ~f~%"
            (-> *p2-math-camera* perspective vector 0 x)
            (-> *p2-math-camera* trans x) (-> *p2-math-camera* trans y) (-> *p2-math-camera* trans z)))
  ;; sky
  (with-profiler "sky"
    (when (zero? (logand *vu1-enable-user* (vu1-renderer-mask sky)))
      (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id sky-draw))
        (dma-buffer-add-gs-set dma-buf
                               (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
                               (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                               (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
        (screen-gradient dma-buf
                         (-> *display* bg-clear-color 0)
                         (-> *display* bg-clear-color 1)
                         (-> *display* bg-clear-color 2)
                         (-> *display* bg-clear-color 3))))
    (when (logtest? *vu1-enable-user* (vu1-renderer-mask sky))
      (cond
        ((and (-> *time-of-day-context* sky) *sky-drawn*) (render-sky-tng *time-of-day-context*))
        (else
         (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id sky-draw))
           (dma-buffer-add-gs-set dma-buf
                                  (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
                                  (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                                  (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
           (screen-gradient dma-buf
                            (-> *time-of-day-context* erase-color)
                            (-> *time-of-day-context* erase-color)
                            (-> *time-of-day-context* erase-color)
                            (-> *time-of-day-context* erase-color)))))))

  ;; ocean
  (with-profiler "ocean"
    (update-ocean)
    (draw-ocean))

  ;; Phase 3F: reset the shadow queue per-pass so each camera's shadow bucket
  ;; contains only its own visible shadows. shadow-execute-all drains but does
  ;; not clear cur-run, so without this reset pass 2's queue would still hold
  ;; pass 1's entries and draw every shadow twice into P2's viewport.
  (set! (-> *shadow-queue* cur-run) (the-as uint 0))

  ;; background
  (with-profiler "background"
    ;; generic-init-buffers emits bucket-init DMA for the generic foreground sinks.
    ;; Must run before execute-connections so sinks are ready when renderers write to them.
    ;; Moved here from real-main-draw-hook so it runs once per camera pass under the correct
    ;; *active-render-cam*, routing each pass's init to the right bucket half.
    (generic-init-buffers)
    (init-background)
    (execute-connections *background-draw-engine* (-> *display* frames (-> *display* on-screen) frame))
    (reset! (-> *perf-stats* data 3))
    (finish-background)
    (read! (-> *perf-stats* data 3))
    (update-wait-stats (-> *perf-stats* data 3) (-> *background-work* wait-to-vu0) (the-as uint 0) (the-as uint 0)))

  ;; foreground engines
  (with-profiler "foreground-engines"
    (foreground-engine-execute (-> *level* level-default foreground-draw-engine 0)
                               (-> *display* frames (-> *display* on-screen) frame)
                               2
                               0)
    (foreground-engine-execute (-> *level* level-default foreground-draw-engine 1)
                               (-> *display* frames (-> *display* on-screen) frame)
                               2
                               1))

  ;; bones / gmerc / shadow / eyes
  (let ((gp-9 (-> *display* frames (-> *display* on-screen) frame global-buf)))
    (with-profiler "bones"
      (bones-mtx-calc-execute))
    (with-profiler "gmerc"
      (generic-merc-execute-all gp-9))
    (with-profiler "shadow"
      (shadow-execute-all gp-9 *shadow-queue*))
    (with-profiler "eyes"
      (update-eyes)))

  ;; Phase 1c/2d: per-pass fp-hud spawn + main HUD draw — co-op only.
  ;; CRITICAL: gate the CALL on *multi-coop-active* (not just the function body) so
  ;; the symbols are never dereferenced in single-player. Both functions are
  ;; forward-decl'd in this file and DEFINED later (target2.gc, hud-classes.gc); if
  ;; draw-world-pass fires before those .o files load (e.g., menu/loading frames
  ;; during GAME.CGO progressive load), an unbound symbol call is an access-violation
  ;; crash. Gating up-front avoids the lookup entirely in SP.
  (when *multi-coop-active*
    (fp-hud-spawn-for-pass (the int *active-render-cam*))
    (hud-draw-for-pass (the int *active-render-cam*)))

  ;; sprite (swap-fake-shadow-buffers is a flip-flop, hoisted out of this pass)
  (when (logtest? (vu1-renderer-mask sprite) *vu1-enable-user*)
    (with-profiler "sprite"
      (sprite-draw *display*)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Vis-bits save / merge / all-visible helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun vis-bits-snapshot! ((buf pointer))
  "Copy each active level's vis-bits into buf.
   Level i occupies buf bytes [i*2048 .. i*2048+qwords*16-1]."
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (and (= (-> lev status) 'active)
                 (-> lev vis-bits)
                 (nonzero? (-> lev bsp)))
        (let ((qwords (min 128 (/ (+ (-> lev bsp visible-list-length) 15) 16))))
          (when (> qwords 0)
            (quad-copy! (the pointer (+ (the-as int buf) (* i 2048)))
                        (-> lev vis-bits)
                        qwords))))))
  (none))

(defun vis-bits-merge-restore! ()
  "Forcefully set each active level's vis-bits to (*p1-vis-save* | *p2-vis-save*).
   This runs after both draw passes so actors-update sees the union of both
   cameras' visible sets. Using saved P1 data (not P1's restore update-visible
   result) is critical — if update-visible fails for P1, vis-bits would otherwise
   remain at P2's values and actors-update would kill P1-visible entities.
   Uses uint64 pairs per quad-word for compiler safety."
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (and (= (-> lev status) 'active)
                 (-> lev vis-bits)
                 (nonzero? (-> lev bsp)))
        (let* ((qwords (min 128 (/ (+ (-> lev bsp visible-list-length) 15) 16)))
               ;; Each quad-word = 16 bytes = 2 uint64s.
               (dst    (the (pointer uint64) (-> lev vis-bits)))
               (p1-src (the (pointer uint64) (+ (the-as int *p1-vis-save*) (* i 2048))))
               (p2-src (the (pointer uint64) (+ (the-as int *p2-vis-save*) (* i 2048)))))
          (dotimes (j (* qwords 2))
            (set! (-> dst j) (logior (-> p1-src j) (-> p2-src j))))))))
  (none))

(defun vis-bits-set-all-visible! ()
  "For each active level, copy bsp.all-visible-list into lev.vis-bits.
   This tells the per-pass background renderer (finish-background →
   add-pc-port-background-data) that every BSP cell is potentially visible,
   effectively disabling BSP occlusion culling for the upcoming draw pass.
   Frustum culling still operates normally per-pass via *math-camera*.
   Called once per camera pass in split-screen mode (Option A fix)."
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (and (= (-> lev status) 'active)
                 (-> lev vis-bits)
                 (nonzero? (-> lev bsp)))
        (let ((qwords (min 128 (/ (+ (-> lev bsp visible-list-length) 15) 16))))
          (when (> qwords 0)
            (quad-copy! (-> lev vis-bits)
                        (-> lev bsp all-visible-list)
                        qwords))))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Dual-pass orchestration
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun multi-draw-both-cameras ()
  "Run draw-world-pass twice, once per camera. On entry *math-camera* holds
   P1 (finalized by update-camera-inner in cam-update.gc). *p2-math-camera*
   holds P2 (also finalized by update-camera-inner). On exit *math-camera*
   holds P1 again so post-draw code sees consistent state.

   Split-screen vis-bits strategy (Session 22.1 + 22.2):
   - Snapshot each camera's actual (leaf-specific) vis-bits BEFORE widening,
     so vis-bits-merge-restore! can give actors-update the P1|P2 union.
   - Widen lev.vis-bits to all-visible BEFORE each draw pass so the background
     renderer (finish-background → add-pc-port-background-data) uploads an
     unconstrained vis-string and walls/crates render regardless of which BSP
     leaf either camera currently occupies."
  ;; Pass 1: P1 camera is already live in *math-camera* (finalized by update-camera).
  (set! *active-render-cam* 0)
  ;; Snapshot P1's camera-specific vis-bits BEFORE widening so actors-update
  ;; later receives the real P1 visible set (not all-visible).
  (vis-bits-snapshot! (the pointer *p1-vis-save*))
  ;; Widen to all-visible so the background renderer draws all geometry that
  ;; falls inside P1's frustum, regardless of BSP leaf boundaries.
  (vis-bits-set-all-visible!)
  (draw-world-pass)

  ;; Activate P2 camera: update-visible writes P2's leaf-specific vis into
  ;; lev.vis-bits, replacing the all-visible state we just set.
  (math-camera-copy! *math-camera-backup* *math-camera*)
  (activate-math-camera! *p2-math-camera*)
  ;; Snapshot P2's camera-specific vis-bits BEFORE widening.
  (vis-bits-snapshot! (the pointer *p2-vis-save*))
  ;; Widen to all-visible for P2's background pass.
  (vis-bits-set-all-visible!)
  (set! *active-render-cam* 1)
  (draw-world-pass)

  ;; Restore P1 for post-draw code (update-visible for P1 runs here, but we
  ;; do not rely on its result — vis-bits-merge-restore! overwrites it below).
  (activate-math-camera! *math-camera-backup*)
  (set! *active-render-cam* 0)

  ;; Forcefully set vis-bits = P1_saved | P2_saved.  actors-update now sees the
  ;; union of both cameras' real visible sets — actors near either player stay
  ;; alive.  An entity invisible to both cameras is correctly culled.
  (vis-bits-merge-restore!)
  (none))
