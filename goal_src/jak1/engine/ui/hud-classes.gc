;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/ui/hud.gc")
(define-extern multi-log-enabled? (function symbol symbol))
(define-extern *multi-coop-active* symbol)
(define-extern *multi-dbg-hud* symbol)
;; get-target is defined in engine/target/target-h.gc; forward-declared here for hud-draw-for-pass.
(define-extern get-target (function int target))
;; [B7] math-camera swap helpers — defined in engine/draw/multi-draw.gc (loads earlier).
(define-extern *p2-math-camera* math-camera)
(define-extern math-camera-copy! (function math-camera math-camera math-camera))

;; [B7] Scratch math-camera used by convert-to-hud-object to save *math-camera*
;; while it temporarily swaps in the picker's camera for world→screen projection.
;; A dedicated global avoids racing with multi-draw.gc's *math-camera-backup*,
;; which is in active use during the render pass.
(define *convert-to-hud-saved-cam* (new 'global 'math-camera))

;; note: changed for high fps

