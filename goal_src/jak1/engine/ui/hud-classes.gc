(defmethod hud-update ((this hud-power))
  ;; Per-viewport HUD Phase 2: power-up eco (red/blue/yellow) is per-player, owner from parent.
  ;; [HUD:power] and [HUD:power-ECO] logs disabled
  (when (-> this parent)
    (let ((owner (the-as target (-> this parent 0))))
      (tally-value this
                   (max 0
                        (min (the-as int
                                     (- (-> owner fact eco-timeout)
                                        (the-as uint (- (-> *display* game-frame-counter) (-> owner fact eco-pickup-time)))))
                             (the-as int (-> owner fact eco-timeout))))
                   (the-as int (-> owner fact eco-timeout)))))
  0
  (none))

(defmethod init-particles! ((this hud-power) (arg0 int))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-0 (-> this nb-of-particles)))
      (set! (-> this particles s5-0) (new 'global 'hud-particle))
      (set! (-> this particles s5-0 part) (create-launch-control group-part-hud-eco-timer-backing this))
      (set! (-> this particles s5-0 init-pos x) 435.0)
      (set! (-> this particles s5-0 init-pos y) 370.0)
      (set! (-> this particles s5-0 init-pos z) 10.0)
      (set! (-> this particles s5-0 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-1 (-> this nb-of-particles)))
      (set! (-> this particles s5-1) (new 'global 'hud-particle))
      (set! (-> this particles s5-1 part) (create-launch-control group-part-hud-timer-blue this))
      (set! (-> this particles s5-1 init-pos x) 432.0)
      (set! (-> this particles s5-1 init-pos y) 368.0)
      (set! (-> this particles s5-1 init-pos z) 3.0)
      (set! (-> this particles s5-1 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (when (< (-> this nb-of-particles) (-> this max-nb-of-particles))
    (let ((s5-2 (-> this nb-of-particles)))
      (set! (-> this particles s5-2) (new 'global 'hud-particle))
      (set! (-> this particles s5-2 part) (create-launch-control group-part-hud-eco-timer this))
      (set! (-> this particles s5-2 init-pos x) 435.0)
      (set! (-> this particles s5-2 init-pos y) 370.0)
      (set! (-> this particles s5-2 init-pos z) 2.0)
      (set! (-> this particles s5-2 part matrix) -1))
    (+! (-> this nb-of-particles) 1))
  (dotimes (s5-3 (-> this nb-of-particles))
    (if (= (-> this particles s5-3 part matrix) -1) (set! (-> this particles s5-3 part matrix) (sprite-allocate-user-hvdf))))
  (set-pos-and-scale this (= (get-aspect-ratio) 'aspect16x9) (= (get-video-mode) 'pal))
  (set! (-> this x-sgn) 1)
  (set! (-> this y-sgn) 1)
  0
  (none))

(defmethod set-pos-and-scale ((this hud-power) (arg0 symbol) (arg1 symbol))
  (cond
    (arg0 (set! (-> this scale-blue) 7168.0) (set! (-> this scale-timer) 11468.8) (set! (-> this scale-backing) 8960.0))
    (else (set! (-> this scale-blue) 8192.0) (set! (-> this scale-timer) 13107.2) (set! (-> this scale-backing) 10240.0)))
  ;; og:preserve-this
  (#when PC_PORT
    (let ((base-x (-> this particles 2 init-pos x)))
      (+! base-x (* (- 512.0 base-x) (- 1.0 (-> *pc-settings* aspect-ratio-reciprocal))))
      (set! (-> this particles 0 init-pos x) 435.0)
      (set! (-> this particles 1 init-pos x) 432.0)
      (set! (-> this particles 2 init-pos x) 435.0)
      (when (not (-> *pc-settings* use-vis?))
        (dotimes (i (-> this nb-of-particles))
          (set! (-> this particles i init-pos x)
                (+ base-x (* (-> *pc-settings* aspect-ratio-reciprocal) (- (-> this particles i init-pos x) base-x))))))))
  0
  (none))

(defun activate-hud ((arg0 process))
  "Per-viewport HUD Phase 2: spawn a full HUD set for the target ARG0, parented to it.
   Identifies ARG0's slot in *target-list* and writes the spawned processes into
   *hud-parts-list* slots[slot]. For slot 0 (P1) ALSO mirrors into legacy *hud-parts*
   so non-HUD callers (collectables.gc, target-handler.gc, hide-hud, etc.) continue
   to find P1's HUDs at the well-known global without changes.

   Each HUD process is parented to its owner via :to arg0, so hud-update methods
   read owner's data via (the-as target (-> self parent 0)) — no global routing."
  (let ((slot -1))
    ;; Slot resolution: try *target-list* first, then fall back to "if arg0 is
    ;; *target*, slot 0" since logic-target.gc:1291 calls activate-hud from inside
    ;; init-target — before localmulti-run-eachframe gets to register slot 0.
    (dotimes (i (-> *target-list* length))
      (if (= (the-as process (get-target i)) arg0)
        (set! slot i)))
    (when (and (< slot 0) (= arg0 (the-as process *target*)))
      (set! slot 0))
    ;; If slot still unresolved, the caller invoked us before *target-list* was
    ;; updated. Skip — caller (start / start-extra-target) is responsible for
    ;; calling activate-hud AFTER process-spawn returns, with *target-list* set.
    (when (and (< slot 0) (multi-log-enabled? 'hud-life))
      (format 0 "[HUD:life] activate-hud SKIP — slot unresolved for target=~A *target*=~A~%" arg0 *target*))
    (when (>= slot 0)
      (let ((parts (-> *hud-parts-list* slots slot)))
        (when (multi-log-enabled? 'hud-life)
          ;; HVDF pool depth diagnostic — count alloc'd slots before first spawn.
          (let ((used 0))
            (dotimes (i 76) (if (nonzero? (-> *sprite-hvdf-control* alloc i)) (+! used 1)))
            (format 0 "[HUD:life] activate-hud slot=~D target=~A hvdf-used=~D/76~%" slot arg0 used)))
        ;; NOTE: do NOT tear down existing parts here. At first spawn the slots are
        ;; #f. At respawn (level transition / death) the kernel already killed the
        ;; old huds via parent death (they were :to arg0); ppointer->process on stale
        ;; references would crash. Just overwrite — old references are safe to drop.
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre pickups~%"))
        (set! (-> parts pickups)    (process-spawn hud-pickups   :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre money~%"))
        (set! (-> parts money)      (process-spawn hud-money     :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre fuel-cell~%"))
        (set! (-> parts fuel-cell)  (process-spawn hud-fuel-cell :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre health~%"))
        (set! (-> parts health)     (process-spawn hud-health    :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre buzzers~%"))
        (set! (-> parts buzzers)    (process-spawn hud-buzzers   :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life) (format 0 "[HUD:life]   pre power~%"))
        (set! (-> parts power)      (process-spawn hud-power     :init hud-init-by-other 0 :to arg0))
        (when (multi-log-enabled? 'hud-life)
          (let ((used 0))
            (dotimes (i 76) (if (nonzero? (-> *sprite-hvdf-control* alloc i)) (+! used 1)))
            (format 0 "[HUD:life]   all spawned, hvdf-used=~D/76~%" used)))
        ;; Session 51 Phase A — N3 instrumentation. Default-active per-event log; one
        ;; line per activate-hud call shows the per-slot pids. Reveals whether each
        ;; viewport gets its OWN hud-health instance (different pids).
        ;; Split into two format calls (GOAL 8-arg function-call cap).
        (when *multi-coop-active*
          (format 0 "[HUD:slot-spawn] slot=~D owner-pid=~D pickups=~D money=~D fuel-cell=~D~%"
            slot
            (if arg0 (-> arg0 pid) -1)
            (if (-> parts pickups)   (-> parts pickups 0 pid) -1)
            (if (-> parts money)     (-> parts money 0 pid) -1)
            (if (-> parts fuel-cell) (-> parts fuel-cell 0 pid) -1))
          (format 0 "[HUD:slot-spawn]   slot=~D health=~D buzzers=~D power=~D~%"
            slot
            (if (-> parts health)    (-> parts health 0 pid) -1)
            (if (-> parts buzzers)   (-> parts buzzers 0 pid) -1)
            (if (-> parts power)     (-> parts power 0 pid) -1)))
        (set! (-> parts bike-speed) (the-as (pointer hud-bike-speed) #f))
        (set! (-> parts bike-heat)  (the-as (pointer hud-bike-heat) #f))
        (set! (-> parts money-all)  (the-as (pointer hud-money-all) #f))
        ;; Legacy mirror: slot 0 → *hud-parts* for non-HUD callers.
        (when (zero? slot)
          (dotimes (hi 9)
            (set! (-> *hud-parts* parts hi) (-> parts parts hi)))))))
  0
  (none))

;; Session 51 Phase B3 — co-op aware mass-event functions.
;; The legacy *hud-parts* targets only slot 0 (P1). In MP, iterate every active
;; player's hud-parts via *hud-parts-list* so subtitle hides, cutscene hides,
;; etc. apply to BOTH viewports symmetrically. Without this, P1's HUDs get
;; hidden but P2's don't (or vice versa), producing the "P2 sees counter,
;; P1 doesn't" symptom on scout fly pickup (subtitle.gc:424 every-frame hide).
;; CRITICAL: zero-guard *target-list* slots before handle->process — see
;; feedback_handle_to_process_zero_guard.md.

(defun hide-hud ()
  (when *target*
    (cond
      (*multi-coop-active*
       (dotimes (slot (-> *target-list* length))
         (when (not (zero? (-> *target-list* slot)))
           (let ((parts (-> *hud-parts-list* slots slot)))
             (dotimes (gp-0 9)
               (if (-> parts parts gp-0) (send-event (ppointer->process (-> parts parts gp-0)) 'hide)))))))
      (else
       (dotimes (gp-0 9)
         (if (-> *hud-parts* parts gp-0) (send-event (ppointer->process (-> *hud-parts* parts gp-0)) 'hide))))))
  0
  (none))

(defun hide-bottom-hud ()
  (when *target*
    (cond
      (*multi-coop-active*
       (dotimes (slot (-> *target-list* length))
         (when (not (zero? (-> *target-list* slot)))
           (let ((parts (-> *hud-parts-list* slots slot)))
             (dotimes (gp-0 4)
               (if (-> parts parts (+ gp-0 4)) (send-event (ppointer->process (-> parts parts (+ gp-0 4))) 'hide)))))))
      (else
       (dotimes (gp-0 4)
         (if (-> *hud-parts* parts (+ gp-0 4)) (send-event (ppointer->process (-> *hud-parts* parts (+ gp-0 4))) 'hide))))))
  0
  (none))

(defun disable-hud ((arg0 int))
  (when *target*
    (dotimes (s5-0 9)
      (when (-> *hud-parts* parts s5-0)
        (if (or (!= (-> *hud-parts* parts s5-0) arg0) (zero? (-> (the-as (pointer hud) (-> *hud-parts* parts s5-0)) 0 value)))
          (send-event (ppointer->process (-> *hud-parts* parts s5-0)) 'hide))
        (if (!= (-> *hud-parts* parts s5-0) arg0) (send-event (ppointer->process (-> *hud-parts* parts s5-0)) 'disable)))))
  0
  (none))

(defun enable-hud ()
  (when *target*
    (cond
      (*multi-coop-active*
       (dotimes (slot (-> *target-list* length))
         (when (not (zero? (-> *target-list* slot)))
           (let ((parts (-> *hud-parts-list* slots slot)))
             (dotimes (gp-0 9)
               (if (-> parts parts gp-0) (send-event (ppointer->process (-> parts parts gp-0)) 'enable)))))))
      (else
       (dotimes (gp-0 9)
         (if (-> *hud-parts* parts gp-0) (send-event (ppointer->process (-> *hud-parts* parts gp-0)) 'enable))))))
  0
  (none))

(defun hide-hud-quick ()
  (when *target*
    (cond
      (*multi-coop-active*
       (dotimes (slot (-> *target-list* length))
         (when (not (zero? (-> *target-list* slot)))
           (let ((parts (-> *hud-parts-list* slots slot)))
             (dotimes (gp-0 9)
               (if (-> parts parts gp-0) (send-event (ppointer->process (-> parts parts gp-0)) 'hide-quick)))))))
      (else
       (dotimes (gp-0 9)
         (if (-> *hud-parts* parts gp-0) (send-event (ppointer->process (-> *hud-parts* parts gp-0)) 'hide-quick))))))
  0
  (none))

(defun show-hud ()
  (when (and *target* (or (not *progress-process*) (hidden? (-> *progress-process* 0))))
    (cond
      (*multi-coop-active*
       (dotimes (slot (-> *target-list* length))
         (when (not (zero? (-> *target-list* slot)))
           (let ((parts (-> *hud-parts-list* slots slot)))
             (dotimes (gp-0 9)
               (if (-> parts parts gp-0) (send-event (ppointer->process (-> parts parts gp-0)) 'show)))))))
      (else
       (dotimes (gp-0 9)
         (if (-> *hud-parts* parts gp-0) (send-event (ppointer->process (-> *hud-parts* parts gp-0)) 'show))))))
  0
  (none))

(defun set-hud-aspect-ratio ((arg0 symbol) (arg1 symbol))
  (let ((gp-0 (= arg0 'aspect16x9))
        (s5-0 (= arg1 'pal)))
    (when *target*
      (dotimes (s4-0 9)
        (if (-> *hud-parts* parts s4-0) (set-pos-and-scale (-> (the-as (pointer hud) (-> *hud-parts* parts s4-0)) 0) gp-0 s5-0)))))
  0
  (none))

(defun hud-hidden? ()
  (local-vars (gp-0 symbol))
  (cond
    (*target*
     (set! gp-0 #t)
     (dotimes (s5-0 9)
       (when (-> *hud-parts* parts s5-0)
         (if (not (hidden? (-> (the-as (pointer hud) (-> *hud-parts* parts s5-0)) 0))) (set! gp-0 #f)))))
    (else (set! gp-0 #t)))
  gp-0)

(defun bottom-hud-hidden? ()
  (local-vars (gp-0 symbol))
  (cond
    (*target*
     (set! gp-0 #t)
     (dotimes (s5-0 4)
       (when (-> *hud-parts* parts (+ s5-0 4))
         (if (not (hidden? (-> (the-as (pointer hud) (-> *hud-parts* parts (+ s5-0 4))) 0))) (set! gp-0 #f)))))
    (else (set! gp-0 #t)))
  gp-0)

(defun activate-orb-all ((arg0 int))
  (if (not (-> *hud-parts* money-all))
    (set! (-> *hud-parts* money-all) (process-spawn hud-money-all :init hud-init-by-other arg0 :to *target*)))
  0)

;; Per-viewport HUD Phase 2: per-pass HUD draw. Called from draw-world-pass
;; (multi-draw.gc) before sprite-draw. Reads the pass's player's HUD set from
;; *hud-parts-list* slots[pass], skipping when that player is in first-person mode
;; (fp-hud handles its own draw). draw-particles is invoked per-pass so each pass's
;; sprite-draw gets the correct *math-camera* HVDF depth values.
(defun hud-draw-for-pass ((pass int))
  (when (and *multi-coop-active* (not (movie?)))
    (let ((pass-tgt (get-target pass)))
      (when pass-tgt
        (let ((in-fps (logtest? (-> pass-tgt state-flags) (state-flags first-person-mode)))
              (parts (-> *hud-parts-list* slots pass)))
          (when (and (multi-log-enabled? 'hud-render)
                     (zero? (logand (-> *display* integral-frame-counter) 127)))
            (format 0 "[HUD:render] hud-draw-for-pass pass=~D tgt=~A fps=~A~%" pass pass-tgt in-fps))
          (when (not in-fps)
            ;; Per-pass: rewrite HVDF with the current camera (draw-particles) AND
            ;; emit static text/numerals to the per-pass debug bucket (draw-hud).
            ;; Both run while *active-render-cam* = pass, so:
            ;;   - draw-particles uses this pass's *math-camera* HVDF
            ;;   - draw-hud's with-dma-buffer-add-bucket lands in bucket-id debug shifted
            ;;     by pass*BUCKET_COUNT (see multi-draw.gc:35-39), routing P1's writes
            ;;     to viewport 0 and P2's to viewport 1.
            ;; Sparticle SPAWN (inside base draw-hud) is gated on (zero? *active-render-cam*)
            ;; so we don't double-spawn — see hud.gc draw-hud.
            (dotimes (hi 9)
              (let ((hp (-> parts parts hi)))
                (when hp
                  (draw-particles (the-as hud (-> hp 0)))
                  (draw-hud (the-as hud (-> hp 0))))))
            ;; Viewport isolation: with glViewport split-screen, HVDF is viewport-relative
            ;; NDC. The same HVDF value renders at the same relative screen position in
            ;; BOTH viewports — P1's health particles show in P2's viewport too, overlapping
            ;; P2's own health particles and producing the "shared gauge" symptom.
            ;; Fix: after drawing this slot's particles for the current pass, write
            ;; HVDF = 0 for all other-slot particles. X=0 gives NDC = (0-2048)/256 = -8,
            ;; which falls outside every scissor rect and is clipped.
            (dotimes (other-slot (-> *target-list* length))
              (when (and (!= other-slot pass) (not (zero? (-> *target-list* other-slot))))
                (let ((other-parts (-> *hud-parts-list* slots other-slot)))
                  (dotimes (hi 9)
                    (let ((hp (-> other-parts parts hi)))
                      (when hp
                        (let ((h (the-as hud (-> hp 0))))
                          ;; Safety: the ppointer slot may hold a stale reference to a
                          ;; killed HUD process during the death/respawn transition window
                          ;; (see Session 51 Daxter-death crash investigation). Old HUDs
                          ;; were :to the dying target — kernel kills them via parent death,
                          ;; but the *hud-parts-list* slot still holds the old ppointer
                          ;; until activate-hud overwrites it. Verify type before accessing
                          ;; particle data — touching freed/reused memory crashes.
                          (when (and h (type-type? (-> h type) hud))
                            (dotimes (pi (-> h nb-of-particles))
                              (when (> (-> h particles pi part matrix) 0)
                                (set-vector! (sprite-get-user-hvdf (-> h particles pi part matrix))
                                             0.0 0.0 0.0 0.0))))))))))))))))
  (none))

(defbehavior convert-to-hud-object process-drawable ((arg0 process-drawable) (arg1 hud))
  (when arg1
    ;; [B7-diag] log which HUD slot was resolved (hud.parent[0] = owner target process).
    (when (and *multi-coop-active* (multi-log-enabled? 'hud-convert))
      (format 0 "[HUD:convert] hud-type=~A parent-pid=~D frame=~D~%"
        (-> arg1 type symbol)
        (if (-> arg1 parent) (-> (the-as process (-> arg1 parent 0)) pid) -1)
        (-> *display* integral-frame-counter)))
    (logclear! (-> arg0 mask) (process-mask actor-pause))
    (let ((s4-0 (new 'stack-no-clear 'vector)))
      ;; [B7] When the picker is P2, swap *math-camera* to *p2-math-camera* for
      ;; the world→screen projection. Otherwise the projection runs through
      ;; whichever camera happens to be live in *math-camera* — which outside
      ;; the P2 render pass is always P1's state, causing P2's pickup-flight
      ;; effects to start from where P1 would see them. The owner is derived
      ;; from arg1's parent (HUDs are spawned :to their target).
      (let ((owner-is-p2?
              (and *multi-coop-active*
                   (-> arg1 parent)
                   (not (zero? (-> *target-list* 1)))
                   (let ((p2 (handle->process (-> *target-list* 1))))
                     (and p2 (= p2 (the-as process (-> arg1 parent 0))))))))
        (cond
          (owner-is-p2?
           (math-camera-copy! *convert-to-hud-saved-cam* *math-camera*)
           (math-camera-copy! *math-camera* *p2-math-camera*)
           (transform-point-vector-scale! s4-0 (-> arg0 root trans))
           (math-camera-copy! *math-camera* *convert-to-hud-saved-cam*))
          (else
           (transform-point-vector-scale! s4-0 (-> arg0 root trans)))))
      (set! (-> arg0 root trans x) (+ -2048.0 (-> s4-0 x)))
      (set! (-> arg0 root trans y) (* 2.0 (+ -2048.0 (-> s4-0 y)))))
    (set! (-> arg0 root trans z) 9999999.0)
    (set! (-> arg0 root trans w) 1.0)
    (set-vector! (-> arg0 root scale) (get-icon-scale-x arg1) (get-icon-scale-y arg1) (get-icon-scale-x arg1) 1.0)
    (set! (-> arg0 draw dma-add-func) dma-add-process-drawable-hud)
    (go hud-collecting (process->handle arg1)))
  0
  (none))
