(defun part-hud-buzzer-func ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 matrix))
  (let* ((lc (-> arg1 key))
         (hud-self (the-as hud-buzzers (if (and lc (-> lc proc)) (-> lc proc) (the-as process #f))))
         (f0-0 (if hud-self (-> hud-self scale) 0.0)))
