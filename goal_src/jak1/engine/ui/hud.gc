;;-*-Lisp-*-
(in-package goal)
(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/common-obs/collectables.gc")
(define-extern multi-log-enabled? (function symbol symbol))
(define-extern *multi-coop-active* symbol)
(define-extern *multi-dbg-hud* symbol)

;; DECOMP BEGINS

(defmethod relocate ((this hud) (arg0 int))
  (dotimes (v1-0 (-> this nb-of-particles))
    (if (nonzero? (-> this particles v1-0 part)) (&+! (-> this particles v1-0 part) arg0)))
  (the-as hud ((method-of-type process relocate) this arg0)))

(defmethod deactivate ((this hud))
  (when (multi-log-enabled? 'hud-life)
    (format 0 "[HUD:life] deactivate type=~A pid=~D parts=~D~%"
      (-> this type) (-> this pid) (-> this nb-of-particles)))
  (dotimes (v1-0 9)
    (if (and (-> *hud-parts* parts v1-0) (= (ppointer->process (-> *hud-parts* parts v1-0)) this))
      (set! (-> *hud-parts* parts v1-0) (the-as (pointer hud) #f))))
  (dotimes (s5-0 (-> this nb-of-particles))
    (kill-and-free-particles (-> this particles s5-0 part))
    (set! (-> this particles s5-0 part matrix) -1))
  ((method-of-type process deactivate) this)
  (none))

;; Per-viewport HUD: resolve the *hud-parts-list* slot owned by THIS hud's parent target.
;; Each spawned hud is parented :to its target (slot 0 = P1, 1 = P2, ...). Walks parent
;; pointer, then locates that target in *target-list* to identify its slot. Falls back
;; to legacy *hud-parts* if no parent or owner not found in target-list (covers the SP
;; pre-coop boot path where *hud-parts-list* is empty and only *hud-parts* is populated).
(defun find-owner-hud-parts ((this hud))
  (let ((owner (if (-> this parent) (the-as process (-> this parent 0)) (the-as process #f))))
    (when owner
      (dotimes (i (-> *target-list* length))
        (let ((tgt (handle->process (-> *target-list* i))))
          (when (and tgt (= tgt owner))
            (return (-> *hud-parts-list* slots i))))))
    *hud-parts*))

;; Session 51 N1 fix: spawn-only helper. In MP, sparticle spawn must happen during
;; process tick (sacred rule: spawning during render-pass leaves particles inactive
;; until next tick — see Session 50 B2 fix). DMA writes happen per-pass via
;; hud-draw-for-pass. So in MP we split: this fires from :post (spawn), draw-hud
;; fires from hud-draw-for-pass (DMA only, base spawn gated off).
(defun hud-spawn-particles! ((this hud))
  (when (and (not (hidden? this)) (not (paused?)))
    (dotimes (s5-0 (-> this nb-of-particles))
      (when (!= s5-0 (-> this skip-particle))
        (if (or (!= (-> this particles 0 pos x) 0.0) (!= (-> this particles 0 pos y) 0.0))
          (spawn (-> this particles s5-0 part) *null-vector*)))))
  0
  (none))

(defmethod draw-hud ((this hud))
  ;; Session 51 N1 fix: in MP, this method runs from hud-draw-for-pass per render
  ;; pass; spawn is handled by hud-spawn-particles! in :post (process tick), so
  ;; gate the spawn loop off in MP. In SP, hud-draw-for-pass never runs and :post
  ;; calls draw-hud directly — spawn fires here as before.
  (when (and (not (hidden? this)) (not (paused?)) (not *multi-coop-active*))
    (dotimes (s5-0 (-> this nb-of-particles))
      (when (!= s5-0 (-> this skip-particle))
        (if (or (!= (-> this particles 0 pos x) 0.0) (!= (-> this particles 0 pos y) 0.0))
          (spawn (-> this particles s5-0 part) *null-vector*)))))
  0
  (none))

(defmethod tally-value ((this hud) (arg0 int) (arg1 int))
  (if (= arg0 (-> this target-value)) (set-time! (-> this last-target-equal-time)))
  (when (and (not *progress-process*)
             (and (!= (-> this last-hide-time) (current-time))
                  (not (movie?))
                  (time-elapsed? (-> *game-info* letterbox-time) (seconds 0.1))
                  (time-elapsed? (-> *game-info* blackout-time) (seconds 0.1))
                  (not (and *target* (logtest? (-> *target* state-flags) (state-flags grabbed))))))
    (when (or (!= (-> this value) arg0)
              (!= (-> this value2) arg1)
              (-> this force-on-screen)
              (or (and (cpad-hold? 0 l2) (not (-> this disable))) (and (not *cheat-mode*) (cpad-hold? 0 r2)) (-> this first-init)))
      ;; modified for pc port
      (cond
        ((cpad-hold? 0 up) (set! *hud-collectable-view* (hud-collectable-view game-totals)))
        ((cpad-hold? 0 down) (set! *hud-collectable-view* (hud-collectable-view level-totals)))
        ((or (cpad-hold? 0 left) (cpad-hold? 0 right)) (set! *hud-collectable-view* (hud-collectable-view original))))
      (cond
        ((and (-> this increment-on-event)
              (< (-> this value) arg0)
              (not (-> this first-init))
              (not (time-elapsed? (-> this last-target-equal-time) (seconds 1.5))))
         (when (and (!= (-> this value) (-> this target-value)) (time-elapsed? (-> this last-increment-time) (seconds 0.1)))
           (sound-play "cursor-options")
           (+! (-> this value) 1)
           (set-time! (-> this last-increment-time))))
        (else
         (if (not (and (not (-> this first-init)) (time-elapsed? (-> this last-target-equal-time) (seconds 1.5))))
           (set! (-> this value) arg0))
         (set! (-> this target-value) arg0)
         (set-time! (-> this last-target-equal-time))))
      (set! (-> this value2) arg1)
      (when (and (not (movie?)) (= *master-mode* 'game) (not (-> this first-init)) (not (-> this disable)))
        ;; Per-viewport HUD: friend send routes to the OWNER's hud-parts slot, not the
        ;; legacy *hud-parts* (which mirrors only slot 0). Eg. P2's hud-pickups friend
        ;; send must reach P2's hud-health, not P1's.
        (when (>= (-> this friend) 0)
          (let ((owner-parts (find-owner-hud-parts this)))
            (send-event (ppointer->process (-> owner-parts parts (-> this friend))) 'show)))
        (when (multi-log-enabled? 'hud-state)
          (format 0 "[HUD:state] type=~A go hud-arriving val=~D->~D target=~D~%"
            (-> this type) (-> this value) arg0 (-> this target-value)))
        ;; Session 51 Phase A — default-active per-event log on tally-value's GO ARRIVING.
        ;; Fires once per actual state transition (NOT per frame), so unthrottled.
        ;; Filtered to types relevant to B3/B4/N1/N2 to keep volume low.
        (when (and *multi-coop-active*
                   (or (= (-> this type) hud-money)
                       (= (-> this type) hud-buzzers)
                       (= (-> this type) hud-pickups)
                       (= (-> this type) hud-power)
                       (= (-> this type) hud-health)))
          (let* ((parent-pid (if (-> this parent) (-> (the-as process (-> this parent 0)) pid) -1))
                 (reason (cond ((-> this force-on-screen) "force")
                               ((cpad-hold? 0 l2) "L2")
                               ((and (not *cheat-mode*) (cpad-hold? 0 r2)) "R2")
                               ((-> this first-init) "init")
                               (else "value"))))
            (format 0 "[HUD:tally-fire] type=~A owner-pid=~D val=~D->~D tgt=~D reason=~A~%"
              (-> this type) parent-pid (-> this value) arg0 (-> this target-value) reason)))
        (go hud-arriving))
      (set-time! (-> this trigger-time))
      (set! (-> this first-init) #f)))
  0
  (none))

(defmethod draw-icons ((this hud))
  (dotimes (v1-0 (-> this nb-of-icons))
    (set-vector! (-> this icons v1-0 icon 0 root scale)
                 (* (-> this icons v1-0 scale-x) (-> *video-parms* relative-x-scale))
                 (* (-> this icons v1-0 scale-y) (-> *video-parms* relative-y-scale))
                 (* (-> this icons v1-0 scale-x) (-> *video-parms* relative-x-scale))
                 1.0)
    (set! (-> this icons v1-0 icon 0 root trans x)
          (the float (+ (-> this icons v1-0 icon-x) -256 (* (-> this x-sgn) (-> this offset)))))
    (set! (-> this icons v1-0 icon 0 root trans y)
          (- (+ (the float (-> this icons v1-0 icon-y))
                (* (the float (-> this y-sgn))
                   (the float (-> this offset))
                   (-> *video-parms* relative-y-scale)
                   (-> *video-parms* relative-y-scale))
                (* (the float (-> this y-offset)) (-> *video-parms* relative-x-scale-reciprical)))
             (the float (-> *video-parms* screen-sy)))))
  0
  (none))

(defmethod draw-particles ((this hud))
  (dotimes (s5-0 (-> this nb-of-particles))
    (when (!= (-> this skip-particle) -2)
      (set! (-> this particles s5-0 pos x)
            (+ -256.0 (the float (* (-> this x-sgn) (-> this offset))) (-> this particles s5-0 init-pos x)))
      (set! (-> this particles s5-0 pos y)
            (* 0.5
               (- (* (-> *video-parms* relative-y-scale)
                     (+ (-> this particles s5-0 init-pos y)
                        (the float (* (-> this y-sgn) (-> this offset)))
                        ;; og:preserve-this
                        (#if PC_PORT
                          (if (not (-> *pc-settings* use-vis?))
                            (* (the float (-> this y-offset)) (-> *video-parms* relative-y-scale))
                            (* (the float (-> this y-offset)) (-> *video-parms* relative-x-scale-reciprical)))
                          (* (the float (-> this y-offset)) (-> *video-parms* relative-x-scale-reciprical)))))
                  (the float (-> *video-parms* screen-sy)))))
      (set! (-> this particles s5-0 pos z) (-> this particles s5-0 init-pos z)))
    (if (> (-> this particles s5-0 part matrix) 0)
      (set-vector! (sprite-get-user-hvdf (-> this particles s5-0 part matrix))
                   (the float (+ (the int (-> this particles s5-0 pos x)) 2048))
                   (the float (+ (the int (-> this particles s5-0 pos y)) 2048))
                   (- (-> *math-camera* hvdf-off z) (* 1024.0 (-> this particles s5-0 pos z)))
                   (-> *math-camera* hvdf-off w))))
  0
  (none))

(defmethod hud-update ((this hud))
  0
  (none))

(defmethod init-particles! ((this hud) (arg0 int))
  0
  (none))

(defmethod get-icon-pos-x ((this hud))
  0)

(defmethod get-icon-pos-y ((this hud))
  0)

(defmethod get-icon-scale-x ((this hud))
  0.0)

(defmethod get-icon-scale-y ((this hud))
  0.0)

(defmethod set-pos-and-scale ((this hud) (arg0 symbol) (arg1 symbol))
  0
  (none))

(defmethod hidden? ((this hud))
  (= (-> this next-state name) 'hud-hidden))

(defstate hud-hidden (hud)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-0 object))
      (when (multi-log-enabled? 'hud-event)
        (format 0 "[HUD:event] hud-hidden type=~A msg=~A from=~A~%" (-> self type) message proc))
      (case message
        (('show) (if (and (not *progress-process*) (!= (-> self last-hide-time) (current-time))) (go hud-arriving)))
        (('hide) (set! v0-0 (current-time)) (set! (-> self last-hide-time) (the-as time-frame v0-0)) v0-0)
        (('hide-quick) (set! v0-0 (current-time)) (set! (-> self last-hide-time) (the-as time-frame v0-0)) v0-0)
        (('increment) (set! v0-0 (+ (-> self target-value) 1)) (set! (-> self target-value) (the-as int v0-0)) v0-0)
        (('sync) (set! v0-0 #t) (set! (-> self first-init) (the-as symbol v0-0)) v0-0)
        (('disable) (set! v0-0 #t) (set! (-> self disable) (the-as symbol v0-0)) v0-0)
        (('enable) (set! (-> self disable) #f) #f)))
  :enter
    (behavior ()
      ;; NOTE: do not call multi-log-enabled? here — hud-init-by-other ends with
      ;; (go hud-hidden), and hud-init-by-other can fire at LOAD TIME via
      ;; hud-classes-pc.gc:464. multi-debug.gc loads later → unbound symbol crash.
      (set! (-> self offset) 128)
      (draw-icons self)
      (draw-particles self)
      (let ((gp-0 (-> self child)))
        (while gp-0
          (send-event (ppointer->process gp-0) 'draw #f)
          (set! gp-0 (-> gp-0 0 brother))))
      (dotimes (gp-1 (-> self nb-of-particles))
        (kill-and-free-particles (-> self particles gp-1 part))
        (set! (-> self particles gp-1 part matrix) -1)))
  :exit
    (behavior ()
      (set! (-> self y-offset) (-> self next-y-offset)))
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (loop
        (suspend)))
  :post
    (behavior ()
      (if (-> self deactivate-when-hidden) (deactivate self))
      (hud-update self)))

(defstate hud-arriving (hud)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-3 object))
      (when (multi-log-enabled? 'hud-event)
        (format 0 "[HUD:event] hud-arriving type=~A msg=~A from=~A~%" (-> self type) message proc))
      ;; Session 51 Phase A — B3/B4 instrumentation. Default-active per-event log on
      ;; every event the HUD receives in arriving state. Filtered to interesting types
      ;; and skipping noisy 'show messages (which fire continuously while L2 held).
      (when (and *multi-coop-active*
                 (not (eq? message 'show))
                 (or (= (-> self type) hud-money)
                     (= (-> self type) hud-buzzers)
                     (= (-> self type) hud-pickups)
                     (= (-> self type) hud-power)
                     (= (-> self type) hud-health)))
        (begin
          (format 0 "[HUD:event-arriving] type=~A self-pid=~D msg=~A from-pid=~D"
            (-> self type) (-> self pid) message
            (if proc (-> proc pid) -1))
          (format 0 " from-type=~A val=~D tgt=~D~%"
            (if proc (-> proc type) 'NONE)
            (-> self value) (-> self target-value))))
      (case message
        (('hide-quick)
         (set-time! (-> self last-hide-time))
         (set! (-> self force-on-screen) #f)
         (set! (-> self offset) 128)
         (draw-particles self)
         (draw-icons self)
         (hud-update self)
         (go hud-hidden))
        (('hide) (set-time! (-> self last-hide-time)) (set! (-> self force-on-screen) #f) (go hud-leaving 10))
        (('show) (if (and (not *progress-process*) (!= (-> self last-hide-time) (current-time))) (go hud-arriving)))
        (('increment) (set! v0-3 (+ (-> self target-value) 1)) (set! (-> self target-value) (the-as int v0-3)) v0-3)
        (('sync) (set! v0-3 #t) (set! (-> self first-init) (the-as symbol v0-3)) v0-3)
        (('disable) (set! v0-3 #t) (set! (-> self disable) (the-as symbol v0-3)) v0-3)
        (('enable) (set! (-> self disable) #f) #f)))
  :enter
    (behavior ()
      (when (multi-log-enabled? 'hud-state)
        (format 0 "[HUD:state] enter hud-arriving type=~A val=~D target=~D parts=~D~%"
          (-> self type) (-> self value) (-> self target-value) (-> self nb-of-particles)))
      ;; Session 51 Phase A — N2/B3 instrumentation. Default-active per-event log on
      ;; arriving entry. Tells us how often each instance re-enters arriving (B3 orb
      ;; double slide-in = same instance enters arriving twice in close succession;
      ;; N2 LT eco bar = power instance enters arriving while already in 'in' state).
      (when (and *multi-coop-active*
                 (or (= (-> self type) hud-money)
                     (= (-> self type) hud-buzzers)
                     (= (-> self type) hud-pickups)
                     (= (-> self type) hud-power)
                     (= (-> self type) hud-health)))
        (let ((parent-pid (if (-> self parent) (-> (the-as process (-> self parent 0)) pid) -1)))
          (format 0 "[HUD:enter-arriving] type=~A self-pid=~D owner-pid=~D val=~D tgt=~D parts=~D~%"
            (-> self type) (-> self pid) parent-pid
            (-> self value) (-> self target-value) (-> self nb-of-particles))))
      (let ((gp-0 (-> self child)))
        (while gp-0
          (send-event (ppointer->process gp-0) 'draw #t)
          (set! gp-0 (-> gp-0 0 brother))))
      (dotimes (gp-1 (-> self nb-of-particles))
        (if (= (-> self particles gp-1 part matrix) -1)
          (let ((slot (sprite-allocate-user-hvdf)))
            (when (multi-log-enabled? 'hud-render)
              (format 0 "[HUD:render] type=~A particle=~D allocated hvdf-slot=~D~%"
                (-> self type) gp-1 slot))
            (set! (-> self particles gp-1 part matrix) slot)))))
  :code
    (behavior ()
      (loop
        (if (not (paused?)) (seekl! (-> self offset) 0 (the int (* 15.0 (-> *display* time-adjust-ratio)))))
        (draw-icons self)
        (if (<= (-> self offset) 0) (go hud-in))
        (when (movie?)
          (set-time! (-> self last-hide-time))
          (set! (-> self force-on-screen) #f)
          (set! (-> self offset) 128)
          (draw-particles self)
          (draw-icons self)
          (hud-update self)
          (go hud-hidden))
        (suspend)))
  :post
    (behavior ()
      (hud-update self)
      ;; spawn must happen during process tick so the sparticle system activates the
      ;; particles before sprite-draw renders them. hud-draw-for-pass (render-pass)
      ;; rewrites HVDF per-camera but cannot spawn — sparticles spawned during render
      ;; pass aren't picked up until the next process tick. So do both here.
      (draw-particles self)
      ;; Session 51 N1 fix: split spawn from DMA writes for per-viewport routing.
      ;; In MP, spawn fires here (process tick); DMA writes happen per-pass via
      ;; hud-draw-for-pass (so each viewport gets its own bucket-half).
      ;; In SP, draw-hud does spawn + DMA in one call — keep that path.
      (cond
        (*multi-coop-active* (hud-spawn-particles! self))
        (else (draw-hud self)))))

(defstate hud-in (hud)
  :event
    (-> hud-arriving
        event)
  :enter
    (behavior ()
      (when (multi-log-enabled? 'hud-state)
        (format 0 "[HUD:state] enter hud-in type=~A val=~D target=~D~%"
          (-> self type) (-> self value) (-> self target-value))))
  :code
    (behavior ()
      (set-time! (-> self trigger-time))
      (while (and (not (time-elapsed? (-> self trigger-time) (seconds 2))) (not (movie?)))
        (set! (-> self offset) 0)
        (draw-icons self)
        (suspend))
      (when (movie?)
        (set-time! (-> self last-hide-time))
        (set! (-> self force-on-screen) #f)
        (set! (-> self offset) 128)
        (draw-particles self)
        (draw-icons self)
        (hud-update self)
        (go hud-hidden))
      (go hud-leaving 5))
  :post
    (-> hud-arriving
        post))

(defstate hud-leaving (hud)
  :event
    (-> hud-arriving
        event)
  :enter
    (behavior ()
      (when (multi-log-enabled? 'hud-state)
        (format 0 "[HUD:state] enter hud-leaving type=~A val=~D target=~D~%"
          (-> self type) (-> self value) (-> self target-value))))
  :code
    (behavior ((arg0 int))
      (loop
        (if (not (paused?)) (seekl! (-> self offset) 128 (the int (* (the float arg0) (-> *display* time-adjust-ratio)))))
        (draw-icons self)
        (when (movie?)
          (set-time! (-> self last-hide-time))
          (set! (-> self force-on-screen) #f)
          (set! (-> self offset) 128)
          (draw-particles self)
          (draw-icons self)
          (hud-update self)
          (go hud-hidden))
        (if (>= (-> self offset) 128) (go hud-hidden))
        (suspend)))
  :post
    (-> hud-arriving
        post))

(defbehavior hud-init-by-other hud ((arg0 int))
  ;; NOTE: do not call multi-log-enabled? here — hud-classes-pc.gc:464 invokes
  ;; (activate-hud-pc *display-pool*) at LOAD TIME, which spawns hud-battle-enemy
  ;; with this init. multi-debug.gc loads later in GAME.CGO, so multi-log-enabled?
  ;; would be unbound at that moment → access-violation crash on boot. Lifecycle
  ;; logging is covered by activate-hud (hud-classes.gc) which fires post-DGO-load.
  (set! (-> self nb-of-icons) 0)
  (set! (-> self nb-of-particles) 0)
  (set! (-> self max-nb-of-particles) 7)
  (set! (-> self first-init) #t)
  (set! (-> self friend) -1)
  (set-time! (-> self last-increment-time))
  (set-time! (-> self last-target-equal-time))
  (set! (-> self increment-on-event) #f)
  (set! (-> self skip-particle) -1)
  (set! (-> self disable) #f)
  (set! (-> self force-on-screen) #f)
  (set! (-> self deactivate-when-hidden) #f)
  (set! (-> self y-offset) 0)
  (set! (-> self next-y-offset) 0)
  (set-time! (-> self last-hide-time))
  (logior! (-> self mask) (process-mask menu))
  (logclear! (-> self mask) (process-mask pause progress))
  (init-particles! self arg0)
  (draw-icons self)
  (draw-particles self)
  (go hud-hidden)
  (none))

(defun send-hud-increment-event ((arg0 hud))
  (when (-> arg0 increment-on-event)
    (send-event arg0 'increment)
    ;; Session 51 B4 fix: in MP, also broadcast 'increment to same-type HUDs in
    ;; the other viewports so their target-value advances in lockstep with the
    ;; picker's. Without this, mirror HUDs's tally-value branch 1 fails the
    ;; (!= value target-value) gate (target-value never advances), so value
    ;; stays stale until branch 2 SNAPs after 1.5s of last-target-equal-time
    ;; elapsed — visible as "P2 counter several seconds late + second slide-in".
    ;;
    ;; CRITICAL: must use (zero? (-> *target-list* i)) BEFORE handle->process —
    ;; the handle->process macro (gkernel-h.gc:369) does (if (-> the-handle process))
    ;; which assumes the kernel sets the field to #f for invalid handles. But for
    ;; zero-initialized *target-list* slots (unused player slots in 2P co-op),
    ;; the field is integer 0 (truthy in GOAL — only #f is false), so handle->process
    ;; derefs a null pointer and crashes. Pattern stolen from get-target (target-h.gc:160).
    (when *multi-coop-active*
      (dotimes (i (-> *target-list* length))
        (when (not (zero? (-> *target-list* i)))
          (let* ((other-parts (-> *hud-parts-list* slots i))
                 (want-type (-> arg0 type)))
            (dotimes (hi 9)
              (let ((proc (ppointer->process (-> other-parts parts hi))))
                ;; Safety: stale ppointers may exist in *hud-parts-list* during the
                ;; death/respawn transition (old HUDs killed via parent death, but slot
                ;; not yet overwritten by activate-hud). The type-type? check filters
                ;; reused/zeroed slots — type field reads as non-hud or #f when memory
                ;; was repurposed. Belt-and-suspenders with the exact-type check below.
                (when (and proc
                           (type-type? (-> proc type) hud)
                           (!= proc (the-as process-tree arg0))
                           (= (-> proc type) want-type))
                  (send-event proc 'increment))))))))))

(defstate hud-collecting (process-drawable)
  :trans
    (behavior ()
      (case (-> self type)
        ((fuel-cell) (fuel-cell-animate))))
  :code
    (behavior ((arg0 handle))
      (let ((s5-0 (new 'stack-no-clear 'vector)))
        (let ((s4-0 (handle->process arg0)))
