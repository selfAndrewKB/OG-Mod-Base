;;-*-Lisp-*-
(in-package goal)

;; name: multi-debug.gc
;; name in dgo: multi-debug
;; dgos: GAME

;; Debug logging for split-screen co-op.
;; Toggle categories at runtime via the REPL:
;;   (set! *multi-dbg* #t)          ;; master switch
;;   (set! *multi-dbg-spawn* #t)    ;; spawn/despawn events
;;   (set! *multi-dbg-camera* #t)   ;; camera management
;;   (set! *multi-dbg-warp* #t)     ;; warp teleports
;;   (set! *multi-dbg-detail* #t)   ;; verbose field dumps
;;   (set! *multi-dbg-draw* #t)     ;; split-screen draw-pass transitions
;;   (set! *multi-dbg-ai* #t)       ;; enemy AI targeting (enemy-target, closest-target-to)
;;   (set! *multi-dbg-part* #t)     ;; particle spawn gating (is-visible?, falloff)
;;   (set! *multi-dbg-pole* #t)     ;; swing-pole stance / active / grab-receive
;;   (set! *multi-dbg-tube* #t)     ;; slide-control watch / ride / 'update receive
;;   (set! *multi-dbg-spike* #t)    ;; swamp-spike-idle proximity / camera-dot
;;
;; Gate all log calls through multi-log-enabled? and emit inline via format;
;; do NOT build intermediate strings — the helper that did so was removed.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Switches
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; All categories default to #f — toggle individually from the REPL when
;; observing a specific system. Leaving any of these #t ships verbose logs.
(define *multi-dbg*        #f)   ;; master — #f silences everything
(define *multi-dbg-spawn*  #f)   ;; spawn, despawn, sidekick lifecycle
(define *multi-dbg-camera* #f)   ;; camera target changes, mode switches
(define *multi-dbg-warp*   #f)   ;; warp teleports, distance checks
(define *multi-dbg-detail* #f)   ;; verbose struct dumps (heavy)
(define *multi-dbg-draw*   #f)   ;; split-screen activation transitions + per-pass dumps
(define *multi-dbg-ai*     #f)   ;; enemy AI targeting — enemy-target handle + closest-target-to selection
(define *multi-dbg-part*   #f)   ;; particle spawn gating — is-visible? / falloff distance per camera
(define *multi-dbg-pole*   #f)   ;; swing-pole stance eligibility, grab-receive, active-wait occupancy
(define *multi-dbg-tube*   #f)   ;; slide-control watch/ride entry, 'update per-rider path-pos
(define *multi-dbg-spike*  #f)   ;; swamp-spike-idle per-target distance + camera-dot sign
(define *multi-dbg-fps*    #f)   ;; first-person aim mode entry/exit, HUD lifecycle

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Logging helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun multi-log-enabled? ((cat symbol))
  "Return #t if master + category are both enabled. Gate inline `format` calls
   with this so the hot path does no work when logging is off."
  (and *multi-dbg*
    (case cat
      (('spawn)   *multi-dbg-spawn*)
      (('camera)  *multi-dbg-camera*)
      (('warp)    *multi-dbg-warp*)
      (('detail)  *multi-dbg-detail*)
      (('draw)    *multi-dbg-draw*)
      (('ai)      *multi-dbg-ai*)
      (('part)    *multi-dbg-part*)
      (('pole)    *multi-dbg-pole*)
      (('tube)    *multi-dbg-tube*)
      (('spike)   *multi-dbg-spike*)
      (('fps)     *multi-dbg-fps*)
      (else #t)
      )
    )
  )

(defun multi-dump-target ((label string) (tgt target))
  "Dump diagnostic fields for a target process. Only prints when detail is on."
  (when (multi-log-enabled? 'detail)
    (format 0 "[MULTI:detail]  --- ~A ---~%" label)
    (format 0 "[MULTI:detail]    type:     ~A~%" (-> tgt type))
    (format 0 "[MULTI:detail]    state:    ~A~%" (-> tgt state))
    (format 0 "[MULTI:detail]    pid:      ~D~%" (-> tgt pid))
    (format 0 "[MULTI:detail]    sidekick: ~A~%" (ppointer->process (-> tgt sidekick)))
    (format 0 "[MULTI:detail]    control:  ~A~%" (-> tgt control))
    (format 0 "[MULTI:detail]    draw:     ~A~%" (-> tgt draw))
    (format 0 "[MULTI:detail]    part:     ~A~%" (-> tgt part))
    (format 0 "[MULTI:detail]    child:    ~A~%" (ppointer->process (-> tgt child)))
    (format 0 "[MULTI:detail]  --- end ---~%")
    )
  (none)
  )
