;;-*-Lisp-*-
(in-package goal)
(require "engine/camera/camera-h.gc")

;; name: localmulti.gc
;; name in dgo: localmulti
;; dgos: GAME

;; Local split-screen co-op support for Jak 1.
;; Ported from OG-Jak2-Multi splitscreen-hack- branch.
;; Extra targets (players 2-4) are stored in *target-list* as handles.
;; Activation: hold L3 on a secondary controller, double-tap D-pad up.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Cheat code state (separate from *cheat-temp* to avoid colliding with main-cheats)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *multi-cheat-temp* (the-as (pointer int32) (malloc 'global 16)))  ;; 4 int32s (indices 0-3)

;; Set to #t the first time P2 is spawned. Never cleared. When #t, P2 is
;; automatically re-spawned if its handle becomes stale (e.g. after an edge-case
;; level transition that kills extra target processes). Also used by
;; split-screen-should-render? (multi-draw.gc) indirectly via *target-list*.
(define *multi-coop-active* #f)

;; Presentation-lock latch set by the draw hook (multi-draw.gc). Localmulti reads
;; this flag (which reflects the PREVIOUS frame's draw-hook state) to know when to
;; enforce target-grab / release on P2 via safe pre-dispatch send-events.
(define-extern *split-screen-presentation-lock-active* symbol)
;; Tracks whether localmulti has sent 'change-mode 'grab to P2 for a presentation.
;; Used to detect the release edge (latch flips false) and send 'end-mode exactly once.
(define *localmulti-presentation-lock-enforced* #f)

(defun localmulti-presentation-grab-state? ((arg0 symbol))
  ;; Presentation locking uses each target mode's native `'grab` transition.
  ;; On foot this becomes `target-grab`, but vehicles keep their own wrapper
  ;; states so they can restore racer/flut-specific physics and HUD state on
  ;; `end-mode`. Treat all three as the same cutscene lock for enforcement and
  ;; release, or P2 can remain stuck in `target-racing-grab` after a fuel-cell
  ;; victory scene.
  (or (= arg0 'target-grab)
      (= arg0 'target-racing-grab)
      (= arg0 'target-flut-grab)))

;; Phase 3G.2 Session B: *camera-p2* and *camera-combiner-p2* come from camera-h.gc
;; via the require above. Process pools live in gkernel.gc and need forward decls here.
(define-extern *camera-dead-pool* dead-pool)
(define-extern *camera-master-dead-pool* dead-pool)
(define-extern *camera-pool* process-tree)
;; Session 18: shared pad-aware spawn helper defined in cam-start.gc
(define-extern cam-start-for-pad (function int none))
;; Forward decl: start-extra-target is defined later in this file but called
;; from localmulti-run-eachframe (which appears earlier).
(define-extern start-extra-target (function int target))
;; One-shot hand-off to init-target: write dst/launch into the heap-persistent
;; globals and set *multi-spawn-warp-active* #t before calling start-extra-target.
;; init-target will then end in (go target-warp-in *multi-spawn-warp-dst* *multi-spawn-warp-launch*)
;; instead of (go target-continue arg0). See engine/target/logic-target.gc.
;; IMPORTANT: these are heap-allocated (new 'global 'vector) in logic-target.gc.
;; Use vector-copy! to write values — never store a stack pointer in them.
(define-extern *multi-spawn-warp-dst* vector)
(define-extern *multi-spawn-warp-launch* vector)
(define-extern *multi-spawn-warp-active* object)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Controller routing hook (called from init-target for every spawned target)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defbehavior runs-on-tgt-int target ()
  "Called at the start of init-target for every spawned target.
   Registers the first target (P1) into *target-list* index 0."
  (when (zero? (-> *target-list* 0))
    (set! (-> *target-list* 0) (process->handle self))
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Alive checks
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun target-alive? ((tgt target))
  "Return #t if the given target process is live."
  (and tgt (nonzero? (-> tgt state)))
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Warp / distance
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun warp-jakA-to-jakB ((jakA target) (jakB target))
  "Teleport jakA to jakB's current position. Zeros velocity + clears physics
   status flags to avoid fall-damage / mid-air landing animations when jakA
   was falling pre-warp. The sync of unknown-qword00 to the new trans prevents
   next-frame physics from computing a giant travel delta against the old
   position (which would collide with intervening geometry at high speed).
   Mirrors the minimal subset of reset-target-state (logic-target.gc:1160)
   that makes sense for a mid-game warp — we skip the dynamics/surface resets
   since jakA stays in whatever level it was in."
  (when (multi-log-enabled? 'warp)
    (format 0 "[MULTI:warp]    ~A -> ~A~%" (-> jakA name) (-> jakB name))
    )
  (vector-copy! (-> jakA control trans) (-> jakB control trans))
  ;; Nudge jakA to jakB's right so the two models don't occupy the same point.
  ;; vector-x-quaternion! extracts jakB's local +X axis (world-space right).
  (let ((right-vec (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> jakB control quat))))
    (vector+float*! (-> jakA control trans) (-> jakA control trans) right-vec (meters 2.0)))
  (set! (-> jakA control transv quad) (the-as uint128 0))
  (set! (-> jakA control status) (cshape-moving-flags))
  (set! (-> (&-> (-> jakA control) unknown-qword00) 0) (-> jakA control trans quad))
  ;; unknown-vector52 is the fall-start / last-safe-ground position. target.gc:1163
  ;; computes fall distance as dot(gravity, vec52 - current_trans), and target.gc:1164
  ;; triggers target-hit-ground-hard if that exceeds *TARGET-bank* fall-far. Without
  ;; resetting it, a P2 warped down from a ledge gets a massive computed fall distance
  ;; even though their actual airborne time was zero. The engine exposes this reset
  ;; via the 'reset-height event (target-handler.gc:136) — direct mutation is
  ;; equivalent and avoids the send-event indirection.
  (set! (-> jakA control unknown-vector52 quad) (-> jakA control trans quad))
  ;; ground-impact-vel is computed from transv dot gravity at each collision tick
  ;; (collide-reaction-target.gc:182) but cached across frames. target.gc:1171 reads
  ;; it in target-hit-ground's :enter BEFORE the next collision pass updates it, so
  ;; a stale pre-warp value still triggers the stumble threshold. Zero it here so the
  ;; landing is guaranteed soft.
  (set! (-> jakA control ground-impact-vel) 0.0)
  )

(defun target-in-level? ((tgt target) (lev level))
  "Return #t if tgt's world position is physically inside lev's BSP boxes.
   Uses the engine's own point-in-boxes? test — the same function the engine
   calls every frame against *math-camera* to set (-> lev inside-boxes?) for P1.
   This is an exact AABB containment check, not a distance approximation, so it
   gives an authoritative answer regardless of how large/overlapping bspheres are.
   Returns #f if lev has no BSP or no boxes (e.g. during loading transitions)."
  (and (-> lev bsp)
       (nonzero? (-> lev bsp boxes))
       (point-in-boxes? lev (-> tgt control trans))))

;; Set by multi-warp-secondaries-in-level when a warp fires mid-frame (during
;; load-state::update!, which runs AFTER process dispatch). Consumed at the top
;; of the NEXT frame by localmulti-run-eachframe, which executes BEFORE process
;; dispatch via the runs-every-frame hook — matching the frame-position of the
;; manual L1+L2+R1+R2 warp, which snaps cleanly from that slot.
(define *multi-pending-snap* #f)

;; Set by start-extra-target after spawning P2. target-continue's :code re-runs
;; move-to-point! before its first vis-loop suspend (where process-spawn returns),
;; so the warp in start-extra-target races against subsequent target-continue
;; resumptions that happen inside execute-math-engine. Consuming this flag in
;; runs-every-frame (pre-dispatch) guarantees the offset is applied BEFORE
;; execute-math-engine submits P2's first draw data.
(define *multi-pending-initial-offset* #f)

(defun multi-snap-camera-for-idx ((idx int))
  "Snap the secondary player's camera to its target position without spring
   smoothing. Must be called from a pre-process-dispatch context (top of frame)
   for reliable results — cam-master-active's :code loop consumes spring state
   during process dispatch, so a snap fired after dispatch this frame lands in
   stale output. Used directly by the manual L1+L2+R1+R2 warp in
   localmulti-run-eachframe. The level-unload path cannot call this directly
   (it fires from load-state::update!, post-dispatch) — it raises
   *multi-pending-snap* instead, which run-eachframe consumes next frame.

   Today only idx=1 (P2) has a native master; additional slots are silent no-ops."
  (when (= idx 1)
    (when (and *camera-p2* (nonzero? (-> *camera-p2* num-slaves)))
      (when (multi-log-enabled? 'warp)
        (let ((slave-state-name (if (> (-> *camera-p2* num-slaves) 0)
                                  (-> *camera-p2* slave 0 0 next-state name)
                                  'no-slave)))
          (format 0 "[MULTI:warp]    snap-cam p2 master=#x~X tracked-target=#x~X master-options=#x~X slave0-state=~A num-slaves=~D~%"
                  *camera-p2* (-> *camera-p2* tracked-target) (-> *camera-p2* master-options)
                  slave-state-name (-> *camera-p2* num-slaves))))
      ;; Kill all four independent interpolators and any stale cam-entity binding:
      ;;
      ;;   'clear-entity → master-unset-region: clears cam-entity, restores default
      ;;                   string lengths, AND internally fires change-state
      ;;                   *camera-base-mode* with (seconds 1.5) — that 1.5s blend
      ;;                   is the ROOT cause of the "catch-up" we kept chasing when
      ;;                   P2 warps out of a cam-entity-bound state. Must override.
      ;;   'change-state *camera-base-mode* 0
      ;;                 → hard-cut override. Time-param 0 hits the branch at
      ;;                   cam-master.gc:720 which deactivates both slaves of a
      ;;                   mid-blend transition, spawns a fresh slave in base mode,
      ;;                   and bypasses the outro blend entirely. This is what
      ;;                   collapses num-slaves back to 1 and gets slave 0 into
      ;;                   cam-string instantly instead of cam-decel.
      ;;   'teleport     → master spring (reset-target-tracking) + fans out to
      ;;                   slaves (snap trans via cam-calc-follow!) and combiner.
      ;;                   cam-string handles this with a real spline re-index.
      ;;   'no-intro     → slave's cam-string intro-curve ramp (intro-t). Also
      ;;                   makes master zero outro-t at cam-master.gc:762 so any
      ;;                   leftover combiner blend lerp is collapsed.
      ;;   'force-blend 0→ combiner's cross-fade (interp-val / force-blend-time)
      ;; Miss any one and you get partial catch-up.
      (send-event *camera-p2* 'clear-entity)
      (send-event *camera-p2* 'change-state *camera-base-mode* 0)
      (send-event *camera-p2* 'no-intro)
      (send-event *camera-p2* 'force-blend 0)
      (send-event *camera-p2* 'teleport)))
  (none))

(defun multi-warp-secondaries-in-level ((lev level))
  "Teleport each alive secondary player to P1 ONLY if their world position is
   physically inside lev's BSP boxes (via target-in-level? → point-in-boxes?).
   Used by the three level-unload hook points in engine/level/level.gc
   (special-vis transition, turn off / deactivate, and final discard) so that a
   P2 peacefully exploring the Village is not yanked to P1 just because the
   Beach is unloading. No-op in single-player."
  (when *target*
    (let ((idx 1))
      (while (< idx (-> *target-list* length))
        (let ((tgt (get-target idx)))
          (when (and (target-alive? tgt) (target-in-level? tgt lev))
            (when (multi-log-enabled? 'warp)
              (format 0 "[MULTI:warp]    lev-unload ~A → warping tgt ~D~%" (-> lev name) idx))
            (warp-jakA-to-jakB tgt *target*)
            ;; Can't snap directly — we're inside load-state::update!, which runs
            ;; post-dispatch this frame. Latch for next frame's run-eachframe.
            (set! *multi-pending-snap* #t)))
        (set! idx (+ idx 1)))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Per-frame logic (hooked into runs-every-frame)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun localmulti-run-eachframe ()
  "Main per-frame co-op update. Updates vehicle state, manages camera,
   handles racer/flutflut sections, and warps lagging players back."

  ;; ── Presentation lock enforcement ──────────────────────────────────────────
  ;; The draw hook (split-screen-update-presentation-lock! in multi-draw.gc) sets
  ;; *split-screen-presentation-lock-active* and directly hides P2 via logior!.
  ;; That handles VISIBILITY immediately (bit-write is safe in draw context).
  ;; INPUT LOCKING requires send-event which must come from here (pre-dispatch),
  ;; where process state-change events are safe.
  ;;
  ;; The latch we read here reflects the PREVIOUS frame's draw-hook result — a
  ;; one-frame latency that is acceptable because P2 is already hidden from the
  ;; draw hook on the same frame the cutscene starts.
  (when *multi-coop-active*
    (let ((p2-tgt (get-target 1)))
      (cond
        ;; Latch is on: enforce target-grab while cutscene is active.
        (*split-screen-presentation-lock-active*
         (when (and (target-alive? p2-tgt) (not (localmulti-presentation-grab-state? (-> p2-tgt state name))))
           (when (multi-log-enabled? 'cutscene)
             (format 0 "[MULTI:cut]  grab enforced (was ~A)~%" (-> p2-tgt state name)))
           (send-event p2-tgt 'change-mode 'grab))
         (set! *localmulti-presentation-lock-enforced* #t))
        ;; Latch just cleared: release P2 from grab and un-hide.
        (*localmulti-presentation-lock-enforced*
         (set! *localmulti-presentation-lock-enforced* #f)
         (when (and p2-tgt (target-alive? p2-tgt))
           ;; Clear hidden regardless of current state — the draw hook set it
           ;; every frame while blocked, and target-exit does NOT clear draw-status.
           ;; Without this, P2 stays permanently invisible after the cutscene.
           (logclear! (-> p2-tgt draw status) (draw-status hidden))
           (when (localmulti-presentation-grab-state? (-> p2-tgt state name))
             (when (multi-log-enabled? 'cutscene)
               (format 0 "[MULTI:cut]  releasing grab (cutscene ended)~%"))
             (send-event p2-tgt 'end-mode)))))))
  ;; ── End presentation lock enforcement ──────────────────────────────────────

  ;; Session 26: defensive sync. runs-on-tgt-int only writes *target-list* 0
  ;; when the slot is zero, so once set it's never refreshed — but P1's target
  ;; process can be re-created during level transitions, leaving slot 0 with a
  ;; stale handle while *target* points at the new live process. Readers that
  ;; go through (get-target 0) instead of *target* then silently skip P1. This
  ;; runs pre-dispatch via runs-every-frame, so it lands before any process
  ;; (e.g. water-vol::update!) reads the slot in the same frame.
  (when *target*
    (set! (-> *target-list* 0) (process->handle *target*)))

  ;; Consume any pending camera snap latched from a post-dispatch context
  ;; (e.g. multi-warp-secondaries-in-level firing from load-state::update!).
  ;; This runs pre-dispatch via runs-every-frame, so cam-master-active's next
  ;; :code iteration sees fully-reset state.
  (when *multi-pending-snap*
    (when (multi-log-enabled? 'warp)
      (format 0 "[MULTI:warp]    consuming pending snap~%"))
    (multi-snap-camera-for-idx 1)
    (set! *multi-pending-snap* #f))

  ;; Consume the initial-offset latch set by start-extra-target. target-continue's
  ;; :code calls move-to-point! before its first vis-loop suspend, which is where
  ;; process-spawn returns — so the warp in start-extra-target is applied to the
  ;; right location, but target-continue may keep running across frames and undo it
  ;; before the first draw tick. Re-applying here (pre-dispatch) guarantees P2's
  ;; first execute-math-engine tick sees the offset position.
  (when (and *multi-pending-initial-offset* *target*)
    (let ((p2-tgt (get-target 1)))
      (when (target-alive? p2-tgt)
        (when (multi-log-enabled? 'warp)
          (format 0 "[MULTI:warp]    applying initial spawn offset for P2~%"))
        (warp-jakA-to-jakB p2-tgt *target*)))
    (set! *multi-pending-initial-offset* #f))

  ;; Permanent co-op guard: if co-op was ever activated but P2's handle is stale
  ;; (process died or was unloaded during a level transition), re-spawn.
  ;; Gate on P1 being past target-continue: that state persists for the entire
  ;; level-load vis-wait loop after initialize!/save-load. Spawning P2 before
  ;; target-continue exits means init-target runs into an unloaded world and
  ;; crashes the boot-game task. Any non-transition state means the level is active.
  ;; Also suppressed during movies so we don't disturb the pov-camera system.
  (when (and *multi-coop-active*
             (target-alive? *target*)
             (not (case (-> *target* state name)
                    (('target-continue 'target-death) #t)
                    (else #f)))
             (not (real-movie?))
             (not (target-alive? (get-target 1))))
    (when (multi-log-enabled? 'spawn)
      (format 0 "[MULTI:spawn]   co-op active — P2 missing, respawning (P1 state: ~A)~%"
              (-> *target* state name)))
    ;; If P1 is mid-portal (in target-warp-in), hand P1's portal anchors to
    ;; init-target via the warp-anchors globals so P2's init-target ends in
    ;; (go target-warp-in ...) and plays the hop-out animation in sync.
    ;; Otherwise, normal target-continue spawn.
    (let ((p1-in-warp (= (-> *target* state name) 'target-warp-in)))
      (when p1-in-warp
        ;; Write directly into the heap-persistent globals — never store a
        ;; stack-no-clear pointer, which dies when this frame returns before
        ;; target-warp-in:enter reads the quad inside process-spawn.
        ;;
        ;; dst = P1's v102 with the -4096 y offset pre-compensated
        ;; (target-warp-out's :enter re-applies that offset on P2).
        (vector-copy! *multi-spawn-warp-dst* (-> *target* control unknown-vector102))
        (+! (-> *multi-spawn-warp-dst* y) 4096.0)
        ;; launch = P1's v103 directly (the destination continue-point position).
        ;; target-warp-in:trans computes transv.xz = (v103 - v102).xz each frame,
        ;; and :code calls set-heading-vec!(transv) after (suspend-for (seconds 1)).
        ;; Mirroring P1's v103 gives P2 the identical heading as P1.
        ;;
        ;; DO NOT use vector-z-quaternion!(P1.control.quat): P1.control.quat is stale
        ;; during the first second of target-warp-in — it was last updated in
        ;; target-warp-out when P1 faced INTO the source portal, which is 180°
        ;; opposite the correct arrival direction. [CONFIRMED Session 25]
        (vector-copy! *multi-spawn-warp-launch* (-> *target* control unknown-vector103))
        (set! *multi-spawn-warp-active* #t))
      (start-extra-target 1)))

  ;; Warp secondary players to *target* only on explicit request (all four
  ;; shoulder buttons held). Auto-warp on distance was removed Session 22:
  ;; the split-screen vis-bits merge (multi-draw.gc) keeps P2-visible entities
  ;; alive regardless of distance to P1, so out-of-range teleports are no
  ;; longer needed and were disruptive to exploration.
  (let ((idx 1))
    (while (< idx (-> *target-list* length))
      (let ((tgt (get-target idx)))
        (when tgt
          (when (and (cpad-hold? idx l1) (cpad-hold? idx l2)
                     (cpad-hold? idx r1) (cpad-hold? idx r2))
            (warp-jakA-to-jakB tgt *target*)
            (multi-snap-camera-for-idx idx)
            )
          )
        )
      (set! idx (+ idx 1))
      )
    )

  ;; Phase 3G.2 Session B: P2 camera finalization runs inside update-camera's
  ;; wrapper (cam-update.gc) via update-camera-inner(*camera-combiner-p2*, *p2-math-camera*).
  ;;
  ;; Detect and repair a stale P2 pipeline. If P2's target
  ;; is alive but *camera-p2* is nil, something (e.g. P1's target-continue calling
  ;; cam-start #t, which runs cam-stop → kill-by-name for all camera processes)
  ;; wiped the P2 camera pipeline. Respawn it and re-wire to P2's target.
  (let ((p2-tgt (get-target 1)))
    ;; Respawn P2 pipeline if cam-stop wiped it (e.g. P1's target-continue → cam-start #t)
    (when (and p2-tgt (target-alive? p2-tgt) (not *camera-p2*))
      (when (multi-log-enabled? 'camera)
        (format 0 "[MULTI:camera]  P2 pipeline missing — respawning via cam-start-for-pad~%"))
      (cam-start-for-pad 1))

    ;; Session 18: rewritten to mirror P1's full init sequence from target-continue lines 124–145.
    ;; Gate: master has run at least one tick (num-slaves > 0, set inside cam-master-active :code)
    ;;        AND wiring has not yet happened (tracked-target is #f).
    ;; Session 19: switched from drawable-target to tracked-target. With the new change-target
    ;; handler, type-target processes stay out of drawable-target (it's for non-target drawables
    ;; only now). tracked-target is what change-target sets for target-type processes, so
    ;; `(not tracked-target)` is the correct "not yet initialized" predicate.
    (when (and p2-tgt (target-alive? p2-tgt) *camera-p2*
               (> (-> *camera-p2* num-slaves) 0)
               (not (-> *camera-p2* tracked-target)))
      (when (multi-log-enabled? 'camera)
        (format 0 "[MULTI:camera]  P2 init: seeding combiner from P1 + full event sequence~%"))
      ;; Seed P2's combiner from P1's live camera state. P2 spawns physically near P1 so
      ;; this is the best approximation of P1's saved continue-point seed in target-continue.
      (set! (-> *camera-combiner-p2* trans quad) (-> *camera-combiner* trans quad))
      (matrix-copy! (-> *camera-combiner-p2* inv-camera-rot) (-> *camera-combiner* inv-camera-rot))
      ;; Send the exact event sequence that target-continue sends after cam-start #t for P1
      ;; (target-death.gc lines 140–145): change-target → no-intro → clear-entity →
      ;; force-blend 0 → change-state cam-fixed 0 → change-state cam-string 0
      (send-event *camera-p2* 'change-target p2-tgt)
      (send-event *camera-p2* 'no-intro)
      (send-event *camera-p2* 'clear-entity)
      (send-event *camera-p2* 'force-blend 0)
      (send-event *camera-p2* 'change-state cam-fixed 0)
      (send-event *camera-p2* 'change-state cam-string 0)))
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Process spawning
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun start-extra-target ((idx int))
  "Spawn, configure, and register a new target process for player slot idx.
   Assigns the correct controller, color, and handle. Returns the target."
  ;; Session 18: delegate to cam-start-for-pad so P2 uses the same spawn structure as
  ;; P1 (combiner sync, master async via process-spawn-function). The async master
  ;; mirrors the two-suspend window that target-continue relies on after cam-start #t.
  (when (= idx 1)
    (when (multi-log-enabled? 'camera)
      (format 0 "[MULTI:camera]  cam-start-for-pad 1 — async master mirrors P1 two-suspend window~%"))
    (cam-start-for-pad 1))
  (when (multi-log-enabled? 'spawn)
    (format 0 "[MULTI:spawn]   start-extra-target idx=~D~%" idx)
    )
  (let ((tgt (-> (process-spawn
                   target
                   :init init-target
                   (-> *game-info* current-continue)
                   :from *target-dead-pool*
                   :to *target-pool*
                   :stack *kernel-dram-stack*
                   ) 0)))
    (warp-jakA-to-jakB tgt *target*)
    ;; target-continue's :code re-applies move-to-point! across multiple frames
    ;; before reaching target-stance. Latch a flag so localmulti-run-eachframe
    ;; re-applies the offset pre-dispatch on the next frame, guaranteeing P2's
    ;; first draw tick sees the correct position.
    (set! *multi-pending-initial-offset* #t)
    ;; Snap P2's camera on the very next pre-dispatch tick so it hard-cuts to the
    ;; follow position rather than interpolating from whatever the camera held before
    ;; (e.g. the intro cutscene camera position after sage.gc fires a continue).
    (set! *multi-pending-snap* #t)
    (set! (-> *target-list* idx) (process->handle tgt))
    ;; Per-viewport HUD Phase 1: copy per-fact shared counters (buzzer/eco-pill) from
    ;; *target* so the new player's HUD reads correct values from frame zero. Game-info
    ;; (money, fuel, buzzer-total) is already shared via the global *game-info* pointer.
    (sync-shared-pickups-to! tgt)
    ;; Per-viewport HUD Phase 2: spawn this target's own HUD set into
    ;; *hud-parts-list* slots[idx], parented to tgt. hud-draw-for-pass picks it up
    ;; per render pass; each HUD's hud-update reads its owner via parent process.
    (activate-hud tgt)
    ;; Per-player color tints (from OG co-op PoC). P2 green disabled per user
    ;; request — Jak's natural model is preferred. P3/P4 tints kept for now
    ;; until those slots have final color assignments.
    (case idx
      ((2) (draw-red tgt))
      ((3) (draw-blue tgt))
      )
    (set! (-> tgt control unknown-cpad-info00) (-> *cpad-list* cpads idx))
    (when (multi-log-enabled? 'spawn)
      (format 0 "[MULTI:spawn]   tgt ~D spawned, cpad ~D~%" idx idx)
      (format 0 "[MULTI:spawn]   sidekick: ~A~%" (ppointer->process (-> tgt sidekick)))
      )
    (multi-dump-target "post-spawn" tgt)
    ;; Session 17: wiring-event sends removed from here. They were firing during the
    ;; same frame as cam-master-init, but (go cam-master-active) from init doesn't
    ;; install the event-hook until the next scheduler dispatch (gstate.gc:292), so
    ;; the events were silently dropped. Wiring now happens from localmulti-run-eachframe
    ;; via self-healing conditional sends gated on drawable-target=#f and slave=cam-free-floating.
    tgt
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Spawn entry points
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun localmulti-start ((tgt-idx int))
  "Spawn the extra target at tgt-idx if not already alive.
   P2 is permanent once spawned — despawn is not supported (crashes engine)."
  (when (> tgt-idx 0)
    (let ((tgt (get-target tgt-idx)))
      (cond
        ((target-alive? tgt)
          ;; already alive — do nothing (P2 is permanent)
          (when (multi-log-enabled? 'spawn)
            (format 0 "[MULTI:spawn]   tgt ~D already alive, ignoring~%" tgt-idx)
            )
          )
        (else
          (start-extra-target tgt-idx)
          ;; Once P2 is spawned, permanently mark co-op as active. The
          ;; auto-respawn logic in localmulti-run-eachframe will keep P2
          ;; alive for the rest of the session regardless of level transitions.
          (when (= tgt-idx 1)
            (set! *multi-coop-active* #t))
          )
        )
      )
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Cheat code hook (called from main-cheats)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun spawn-extra-targets-code ()
  "Called every frame from main-cheats. Secondary players hold L3 and
   double-tap D-pad up to toggle their Jak in/out."
  (let ((idx 1))
    (while (< idx (-> *target-list* length))
      (when (and (cpad-hold? idx l3)
                 (or *cheat-mode* (= *kernel-boot-message* 'play))
                 )
        (check-cheat-code (-> *multi-cheat-temp* idx) idx
          (up up)
          (cpad-clear! idx r1)
          (cheats-sound-play *cheat-mode*)
          (localmulti-start idx)
          )
        )
      (set! idx (+ idx 1))
      )
    )
  (none)
  )
