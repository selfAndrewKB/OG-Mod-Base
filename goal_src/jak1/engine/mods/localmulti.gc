;;-*-Lisp-*-
(in-package goal)
(require "engine/camera/camera-h.gc")

;; name: localmulti.gc
;; name in dgo: localmulti
;; dgos: GAME

;; Local split-screen co-op support for Jak 1.
;; Ported from OG-Jak2-Multi splitscreen-hack- branch.
;; Extra targets (players 2-4) are stored in *target-list* as handles.
;; Activation: hold L3 on a secondary controller, double-tap D-pad up.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Cheat code state (separate from *cheat-temp* to avoid colliding with main-cheats)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *multi-cheat-temp* (the-as (pointer int32) (malloc 'global 16)))  ;; 4 int32s (indices 0-3)

;; Phase 3G.2 Session B: *camera-p2* and *camera-combiner-p2* come from camera-h.gc
;; via the require above. Process pools live in gkernel.gc and need forward decls here.
(define-extern *camera-dead-pool* dead-pool)
(define-extern *camera-master-dead-pool* dead-pool)
(define-extern *camera-pool* process-tree)
;; Session 18: shared pad-aware spawn helper defined in cam-start.gc
(define-extern cam-start-for-pad (function int none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Controller routing hook (called from init-target for every spawned target)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defbehavior runs-on-tgt-int target ()
  "Called at the start of init-target for every spawned target.
   Registers the first target (P1) into *target-list* index 0."
  (when (zero? (-> *target-list* 0))
    (set! (-> *target-list* 0) (process->handle self))
    )
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Alive checks
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun target-alive? ((tgt target))
  "Return #t if the given target process is live."
  (and tgt (nonzero? (-> tgt state)))
  )

(defun extra-target-alive? ()
  "Return #t if any secondary target (index 1+) is currently alive."
  (let ((idx 1))
    (while (< idx (-> *target-list* length))
      (when (target-alive? (get-target idx))
        (return #t)
        )
      (set! idx (+ idx 1))
      )
    )
  #f
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Warp / distance
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun warp-jakA-to-jakB ((jakA target) (jakB target))
  "Teleport jakA to jakB's current position."
  (when (multi-log-enabled? 'warp)
    (format 0 "[MULTI:warp]    ~A -> ~A~%" (-> jakA name) (-> jakB name))
    )
  (vector-copy! (-> jakA control trans) (-> jakB control trans))
  )

(defun check-multi-jak-dist ((jak target))
  "Return #t if jak is too far from *target* and should be warped back.
   Suppressed during launch / high-jump states to avoid mid-air teleports."
  (case (-> jak state)
    ((target-launch target-duck-high-jump target-duck-high-jump-jump)
      #f
      )
    (else
      (> (vector-vector-distance (-> jak control trans) (target-pos 0)) (meters 75.0))
      )
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Vehicle-section state detection
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *multi-racer?* #f)
(define *multi-flutflut?* #f)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Camera helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Phase 3G.2 Session B: P2 camera is now fully handled by its own native
;; cam-master + cam-combiner + cam-slave pipeline. Slave reads cpad 1 directly
;; via (-> self pad-index) (propagated from master in cam-slave-init).

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Per-frame logic (hooked into runs-every-frame)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun localmulti-run-eachframe ()
  "Main per-frame co-op update. Updates vehicle state, manages camera,
   handles racer/flutflut sections, and warps lagging players back."

  ;; Update racer / flutflut flags based on *target*'s current state
  (set! *multi-racer?*
    (aif *target*
      (case (-> it state name)
        (('target-racing
          'target-racing-bounce
          'target-racing-death
          'target-racing-falling
          'target-racing-grab
          'target-racing-hit
          'target-racing-jump
          'target-racing-smack
          'target-racing-start) #t)
        )
      )
    )
  (set! *multi-flutflut?*
    (aif *target*
      (case (-> it state name)
        (('target-flut-air-attack
          'target-flut-air-attack-hit-ground
          'target-flut-double-jump
          'target-flut-falling
          'target-flut-grab
          'target-flut-hit
          'target-flut-hit-ground
          'target-flut-jump
          'target-flut-running-attack
          'target-flut-stance
          'target-flut-start
          'target-flut-walk) #t)
        )
      )
    )

  ;; Phase 3G: drawable-target override removed. Forcing *camera* drawable-target
  ;; every frame triggered reset-drawable-tracking in cam-master, snapping all
  ;; smoothing accumulators and causing a visible jolt on P2 spawn. P1's camera
  ;; already tracks *target* through the normal cam-master path — no override needed. In the Phase 3F dual-pass
  ;; architecture P2's camera is fully independent of P1's, so there is
  ;; no reason to alter P1's camera state (cam-string → cam-stick) or
  ;; to reset the camera during racer/flutflut sections.  P1's camera
  ;; is now handled entirely by vanilla cam-update.
  ;;
  ;; *multi-racer?* / *multi-flutflut?* are still updated above in case
  ;; we need them for future vehicle-mode logic (e.g. spring tuning).

  ;; Warp secondary players to *target* if they hold all four shoulder buttons, or are too far
  (let ((idx 1))
    (while (< idx (-> *target-list* length))
      (let ((tgt (get-target idx)))
        (when tgt
          (when (or
                  (and (cpad-hold? idx l1) (cpad-hold? idx l2)
                       (cpad-hold? idx r1) (cpad-hold? idx r2))
                  (check-multi-jak-dist tgt)
                  )
            (warp-jakA-to-jakB tgt *target*)
            )
          )
        )
      (set! idx (+ idx 1))
      )
    )

  ;; Phase 3G.2 Session B: P2 camera finalization runs inside update-camera's
  ;; wrapper (cam-update.gc) via update-camera-inner(*camera-combiner-p2*, *p2-math-camera*).
  ;;
  ;; Detect and repair a stale P2 pipeline. If P2's target
  ;; is alive but *camera-p2* is nil, something (e.g. P1's target-continue calling
  ;; cam-start #t, which runs cam-stop → kill-by-name for all camera processes)
  ;; wiped the P2 camera pipeline. Respawn it and re-wire to P2's target.
  (let ((p2-tgt (get-target 1)))
    ;; Respawn P2 pipeline if cam-stop wiped it (e.g. P1's target-continue → cam-start #t)
    (when (and p2-tgt (target-alive? p2-tgt) (not *camera-p2*))
      (when (multi-log-enabled? 'camera)
        (format 0 "[MULTI:camera]  P2 pipeline missing — respawning via cam-start-for-pad~%"))
      (cam-start-for-pad 1))

    ;; Session 18: rewritten to mirror P1's full init sequence from target-continue lines 124–145.
    ;; Gate: master has run at least one tick (num-slaves > 0, set inside cam-master-active :code)
    ;;        AND wiring has not yet happened (tracked-target is #f).
    ;; Session 19: switched from drawable-target to tracked-target. With the new change-target
    ;; handler, type-target processes stay out of drawable-target (it's for non-target drawables
    ;; only now). tracked-target is what change-target sets for target-type processes, so
    ;; `(not tracked-target)` is the correct "not yet initialized" predicate.
    (when (and p2-tgt (target-alive? p2-tgt) *camera-p2*
               (> (-> *camera-p2* num-slaves) 0)
               (not (-> *camera-p2* tracked-target)))
      (when (multi-log-enabled? 'camera)
        (format 0 "[MULTI:camera]  P2 init: seeding combiner from P1 + full event sequence~%"))
      ;; Seed P2's combiner from P1's live camera state. P2 spawns physically near P1 so
      ;; this is the best approximation of P1's saved continue-point seed in target-continue.
      (set! (-> *camera-combiner-p2* trans quad) (-> *camera-combiner* trans quad))
      (matrix-copy! (-> *camera-combiner-p2* inv-camera-rot) (-> *camera-combiner* inv-camera-rot))
      ;; Send the exact event sequence that target-continue sends after cam-start #t for P1
      ;; (target-death.gc lines 140–145): change-target → no-intro → clear-entity →
      ;; force-blend 0 → change-state cam-fixed 0 → change-state cam-string 0
      (send-event *camera-p2* 'change-target p2-tgt)
      (send-event *camera-p2* 'no-intro)
      (send-event *camera-p2* 'clear-entity)
      (send-event *camera-p2* 'force-blend 0)
      (send-event *camera-p2* 'change-state cam-fixed 0)
      (send-event *camera-p2* 'change-state cam-string 0)))
  (none)
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Process spawning
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun start-extra-target ((idx int))
  "Spawn, configure, and register a new target process for player slot idx.
   Assigns the correct controller, color, and handle. Returns the target."
  ;; Session 18: delegate to cam-start-for-pad so P2 uses the same spawn structure as
  ;; P1 (combiner sync, master async via process-spawn-function). The async master
  ;; mirrors the two-suspend window that target-continue relies on after cam-start #t.
  (when (= idx 1)
    (when (multi-log-enabled? 'camera)
      (format 0 "[MULTI:camera]  cam-start-for-pad 1 — async master mirrors P1 two-suspend window~%"))
    (cam-start-for-pad 1))
  (when (multi-log-enabled? 'spawn)
    (format 0 "[MULTI:spawn]   start-extra-target idx=~D~%" idx)
    )
  (let ((tgt (-> (process-spawn
                   target
                   :init init-target
                   (-> *game-info* current-continue)
                   :from *target-dead-pool*
                   :to *target-pool*
                   :stack *kernel-dram-stack*
                   ) 0)))
    (warp-jakA-to-jakB tgt *target*)
    (set! (-> *target-list* idx) (process->handle tgt))
    (case idx
      ((1) (draw-green tgt))
      ((2) (draw-red tgt))
      ((3) (draw-blue tgt))
      )
    (set! (-> tgt control unknown-cpad-info00) (-> *cpad-list* cpads idx))
    (when (multi-log-enabled? 'spawn)
      (format 0 "[MULTI:spawn]   tgt ~D spawned, cpad ~D~%" idx idx)
      (format 0 "[MULTI:spawn]   sidekick: ~A~%" (ppointer->process (-> tgt sidekick)))
      )
    (multi-dump-target "post-spawn" tgt)
    ;; Session 17: wiring-event sends removed from here. They were firing during the
    ;; same frame as cam-master-init, but (go cam-master-active) from init doesn't
    ;; install the event-hook until the next scheduler dispatch (gstate.gc:292), so
    ;; the events were silently dropped. Wiring now happens from localmulti-run-eachframe
    ;; via self-healing conditional sends gated on drawable-target=#f and slave=cam-free-floating.
    tgt
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Spawn entry points
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun localmulti-start ((tgt-idx int))
  "Spawn the extra target at tgt-idx if not already alive.
   P2 is permanent once spawned — despawn is not supported (crashes engine)."
  (when (> tgt-idx 0)
    (let ((tgt (get-target tgt-idx)))
      (cond
        ((target-alive? tgt)
          ;; already alive — do nothing (P2 is permanent)
          (when (multi-log-enabled? 'spawn)
            (format 0 "[MULTI:spawn]   tgt ~D already alive, ignoring~%" tgt-idx)
            )
          )
        (else
          (start-extra-target tgt-idx)
          )
        )
      )
    )
  (none)
  )

(defun localmulti-start-all ((x int))
  "Spawn extra targets for player slots 1 through x-1."
  (let ((idx 1))
    (while (< idx x)
      (localmulti-start idx)
      (set! idx (+ idx 1))
      )
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Cheat code hook (called from main-cheats)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun spawn-extra-targets-code ()
  "Called every frame from main-cheats. Secondary players hold L3 and
   double-tap D-pad up to toggle their Jak in/out."
  (let ((idx 1))
    (while (< idx (-> *target-list* length))
      (when (and (cpad-hold? idx l3)
                 (or *cheat-mode* (= *kernel-boot-message* 'play))
                 )
        (check-cheat-code (-> *multi-cheat-temp* idx) idx
          (up up)
          (cpad-clear! idx r1)
          (cheats-sound-play *cheat-mode*)
          (localmulti-start idx)
          )
        )
      (set! idx (+ idx 1))
      )
    )
  (none)
  )
