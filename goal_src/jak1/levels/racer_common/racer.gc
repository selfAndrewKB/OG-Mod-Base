;;-*-Lisp-*-
(in-package goal)
(bundles "FIC.DGO" "LAV.DGO" "MIS.DGO" "OGR.DGO" "ROL.DGO")
(require "levels/common/blocking-plane.gc")
(require "engine/common-obs/generic-obs.gc")
(require "engine/entity/ambient.gc")
(require "engine/game/task/task-control.gc")
(define-extern *allow-zoomer-anywhere* symbol)

(define-extern blocking-plane-destroy (function none))

(define-extern blocking-plane-spawn (function curve-control none :behavior process))

(define-extern init-entity (function process entity-actor none))

;; DECOMP BEGINS

(if (not (nmember "racerp" *kernel-packages*)) (set! *kernel-packages* (cons "racerp" *kernel-packages*)))

(define *racer-spawning-entity-copy* #f)

(deftype racer (process-drawable)
  ((root            collide-shape-moving :override)
   (parent-override (pointer target) :overlay-at parent)
   (extra-trans     vector :inline)
   (condition       int32)
   (cell            handle)
   (path-data       path-control 2)
   (path-target     curve-control :overlay-at (-> path-data 0))
   (path-racer      path-control :overlay-at (-> path-data 1))
   (auto-get-off    symbol)
   (shadow-backup   shadow-geo)
   (rider           handle)
   (player-index    int32))
  (:state-methods
   wait-for-start
   idle
   (pickup (state collectable))
   wait-for-return))


(defmethod relocate ((this racer) (offset int))
  (countdown (v1-0 2)
    (if (-> this path-data v1-0) (&+! (-> this path-data v1-0) offset)))
  (the-as racer ((method-of-type process-drawable relocate) this offset)))

(defskelgroup *racer-sg*
  racer
  racer-geo-jg
  racer-racer-idle-ja
  ((racer-geo-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3.5)
  :shadow racer-shadow-mg
  :sort 1)

(defskelgroup *racer-explode-sg*
  racer
  racer-explode-lod0-jg
  racer-explode-idle-ja
  ((racer-explode-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3.5))

(define *racer-shadow-control*
  (new 'static
       'shadow-control
       :settings
       (new 'static
            'shadow-settings
            :flags (shadow-flags disable-fade shdf03)
            :shadow-dir
            (new 'static 'vector :y -1.0 :w 614400.0)
            :bot-plane
            (new 'static 'plane :y 1.0 :w 81920.0)
            :top-plane
            (new 'static 'plane :y 1.0 :w 2048.0))))

(defbehavior racer-effect racer ()
  (when (!= (-> self condition) 4)
    (spawn (-> self part) (-> self root trans))
    (update! (-> self sound)))
  0
  (none))

(defun racer-pin-entity! ((r racer))
  ;; Only the level-authored original participates in actor visibility GC. The
  ;; P2 entity copy is manually owned, so its lifetime is routed by player-index.
  (when (and (zero? (-> r player-index)) (-> r entity))
    (when *multi-coop-active*
      (format 0 "[VEH:racer] PIN self=~A pidx=~D entity=~A rider-set=~A state=~A~%"
        r
        (-> r player-index)
        (-> r entity)
        (not (zero? (-> r rider)))
        (if (-> r state) (-> r state name) 'none)))
    (logior! (-> r entity extra perm status) (entity-perm-status bit-3))))

(defun racer-unpin-entity! ((r racer))
  ;; Keep the pin/unpin predicate symmetric so lifetime bugs don't drift between
  ;; the level-authored original and the co-op entity copy.
  (when (and (zero? (-> r player-index)) (-> r entity))
    (when *multi-coop-active*
      (format 0 "[VEH:racer] UNPIN self=~A pidx=~D entity=~A rider-set=~A state=~A~%"
        r
        (-> r player-index)
        (-> r entity)
        (not (zero? (-> r rider)))
        (if (-> r state) (-> r state name) 'none)))
    (logclear! (-> r entity extra perm status) (entity-perm-status bit-3))))

(defun racer-copy-entity-for-p2! ((src entity-actor) (xoff float))
  (let* ((ent (the-as entity-actor (copy src 'global)))
         (link (new 'global 'entity-links)))
    (+! (-> ent trans x) xoff)
    (set! (-> ent aid) (+ (-> src aid) 10000))
    (set! (-> ent extra) link)
    ;; This is only a transition bridge until we have a second authored racer
    ;; entity. Do not mutate res-lump data here: copy is shallow for tags like
    ;; `name`, so add-data! would rename the original level racer too.
    (set! (-> link prev-link) link)
    (set! (-> link next-link) link)
    (set! (-> link entity) ent)
    (set! (-> link process) #f)
    (set! (-> link level) (-> src extra level))
    (set! (-> link trans quad) (-> ent trans quad))
    (set! (-> link perm user-object 0) (-> src extra perm user-object 0))
    (set! (-> link perm user-object 1) (-> src extra perm user-object 1))
    (set! (-> link perm status) (logior (-> src extra perm status) (entity-perm-status bit-3)))
    (set! (-> link perm task) (-> src extra perm task))
    (set! (-> link perm aid) (the-as actor-id (-> ent aid)))
    (set! (-> link vis-id) (-> src extra vis-id))
    ent))

(defun racer-spawn-entity-copy-for-p2! ((src entity-actor) (xoff float))
  (let ((ent (racer-copy-entity-for-p2! src xoff))
        (proc (get-process *default-dead-pool* racer #x4000)))
    (when proc
      (set! (-> proc type) racer)
      (set! *racer-spawning-entity-copy* #t)
      (init-entity proc ent)
      (set! *racer-spawning-entity-copy* #f)
      (let ((r (the-as racer (-> ent extra process))))
        (when r
          (set! (-> r player-index) 1))))
    (none)))

(defmethod deactivate ((this racer))
  (when *multi-coop-active*
    (format 0 "[VEH:racer] DEACTIVATE self=~A pidx=~D entity=~A rider-set=~A state=~A~%"
      this
      (-> this player-index)
      (-> this entity)
      (not (zero? (-> this rider)))
      (if (-> this state) (-> this state name) 'none)))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defstate wait-for-start (racer)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-1 structure))
      (case message
        (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))
        (('notify) (set! v0-1 #t) (set! (-> self auto-get-off) (the-as symbol v0-1)) v0-1)
        (('shadow)
         (cond
           ((-> block param 0) (set! v0-1 (-> self shadow-backup)) (set! (-> self draw shadow) (the-as shadow-geo v0-1)) v0-1)
           (else (set! (-> self draw shadow) #f) #f)))))
  :exit
    (behavior ()
      (set! (-> self root root-prim prim-core action) (collide-action))
      (set! (-> self root root-prim prim-core offense) (collide-offense no-offense))
      0)
  :code
    (behavior ()
      (label cfg-0)
      (case (-> self condition)
        ((2)
         (let ((gp-0 (get-task-control (-> self entity extra perm task))))
           (if (and *cheat-mode* (cpad-hold? 0 l3)) (goto cfg-77))
           (first-any gp-0 #t)
           (case (current-status gp-0)
             (((task-status need-reward-speech))
              (ja-channel-set! 1)
              (ja :group! racer-racer-idle-ja)
              (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
              (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
              (ja-post))
             (((task-status invalid)) (goto cfg-77)))))
        ((6)
         (if (or (task-closed? (game-task village2-levitator) (task-status need-hint))
                 (and *cheat-mode* (cpad-hold? 0 l3))
                 (not (zero? (-> self rider))))
           (goto cfg-77)))
        ((5)
         (cond
           ((and *cheat-mode* (cpad-hold? 0 l3)) (goto cfg-77))
           ((>= (-> *game-info* fuel) 72.0) (goto cfg-77))))
        ((3)
         (cond
           ((and (task-complete? *game-info* (-> self entity extra perm task)) (not (handle->process (-> self cell))))
            (when (and (-> self auto-get-off)
                       (not (zero? (-> self rider)))
                       (let ((rp (handle->process (-> self rider))))
                         (and rp (send-event rp 'end-mode))))
              (set! (-> self auto-get-off) #f)
              (go-virtual pickup (the-as (state collectable) (method-of-object self idle))))
            (set! (-> self auto-get-off) #f)
            (goto cfg-77))
           ((not (handle->process (-> self cell)))
            (set! (-> self cell)
                  (ppointer->handle (birth-pickup-at-point (vector+! (new 'stack-no-clear 'vector) (-> self root trans) (new 'static 'vector :y 8192.0 :w 1.0))
                                                           (pickup-type fuel-cell)
                                                           (the float (-> self entity extra perm task))
                                                           #f
                                                           self
                                                           (-> self fact)))))))
        ((4)
         (if (zero? (-> self rider)) (goto cfg-77)))
        (else (goto cfg-77)))
      (racer-effect)
      (suspend)
      (b! #t cfg-0 :delay (nop!))
      (label cfg-77)
      (if (not (zero? (-> self rider)))
        (go-virtual wait-for-return)
        (go-virtual idle))))

;; Find the nearest unclaimed target for the racer owner's pad. We key off the
;; target's control pad number instead of *target-list* ordering because co-op
;; target slots are not stable enough to treat "index N" as "player N".
(defun racer-find-nearest-target ((trans vector) (max-dist float) (pad-idx int))
  (let ((tgt (the-as target #f))
        (best-dist max-dist))
    (dotimes (idx (-> *target-list* length))
      (let ((candidate (get-target idx)))
        (when (and candidate
                   (= (-> candidate control unknown-cpad-info00 number) pad-idx)
                   (not (logtest? (-> candidate control root-prim prim-core action) (collide-action racer))))
          (let ((d (vector-vector-distance trans (-> candidate control trans))))
            (when (< d best-dist)
              (set! best-dist d)
              (set! tgt candidate))))))
    tgt))

(defun racer-try-prompt-mount! ((r racer) (tgt target))
  (let ((mounted #f))
    ;; Keep racer idle under the entity-pool stack limit. Drawing the prompt,
    ;; routing the rider-owned display gate, and sending change-mode are
    ;; sequential work, so they live here instead of bloating the state body.
    (hide-hud)
    (level-hint-surpress!)
    (kill-current-level-hint '() '(sidekick voicebox) 'exit)
    (when (and (hud-hidden?) (can-grab-display-for-target? r tgt))
      (print-press-to-use-for-target tgt)
      (when (cpad-pressed? (-> tgt control unknown-cpad-info00 number) circle)
        (when (send-event tgt 'change-mode 'racing r)
          (when *multi-coop-active*
            (format 0 "[VEH:racer] MOUNT self=~A pidx=~D tgt=~A tgt-pad=~D~%"
              r
              (-> r player-index)
              tgt
              (-> tgt control unknown-cpad-info00 number)))
          ;; Claim immediately so the paired racer can't also accept the same
          ;; circle press before target-racing-start sets the action bit.
          (logior! (-> tgt control root-prim prim-core action) (collide-action racer))
          (set! (-> r rider) (process->handle tgt))
          (set! mounted #t))))
    mounted))

(defstate idle (racer)
  :virtual #t
  :event
    (-> (method-of-type racer wait-for-start)
        event)
  :enter
    (behavior ()
      (blocking-plane-destroy)
      (if (and (not *allow-zoomer-anywhere*) (zero? (-> self player-index))) (blocking-plane-spawn (-> self path-target)))
      ;; Close the mount-frame gap before pickup/wait-for-return runs.
      (racer-pin-entity! self)
      (none)) ;; mod-base-change
  :exit (-> (method-of-type racer wait-for-start) exit)
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja :group! racer-racer-idle-ja)
      (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
      (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
      0.0
    ;; <modbase:preserve-this> Reduce auto-mount distance from 15 meters to 6 meters to avoid crash in Lava Tube.
    (let ((f30-0 (if (= (-> self condition) 4) 24576.0 20480.0)))
      (loop
        (if (not (zero? (-> self rider)))
          (go-virtual wait-for-return))
        (let ((tgt (racer-find-nearest-target (-> self root trans) f30-0 (-> self player-index))))
          (when (and tgt (not (movie?)) (not (level-hint-displayed?)))
            (cond
              ((zero? (-> self player-index))
               ;; Original racer uses the same helper as the co-op duplicate;
               ;; the helper keeps the prompt path out of this tiny idle stack.
               (when (racer-try-prompt-mount! self tgt)
                 (go-virtual pickup (the-as (state collectable) (method-of-object self wait-for-return))))
                (when (= (-> self condition) 4)
                  (when (send-event tgt 'change-mode 'racing self)
                    (when *multi-coop-active*
                       (format 0 "[VEH:racer] AUTO-MOUNT self=~A pidx=~D tgt=~A tgt-pad=~D~%"
                         self
                         (-> self player-index)
                         tgt
                         (-> tgt control unknown-cpad-info00 number)))
                     (logior! (-> tgt control root-prim prim-core action) (collide-action racer))
                     (set! (-> self rider) (process->handle tgt))
                     (go-virtual pickup (the-as (state collectable) (method-of-object self wait-for-return))))))
              (else
               ;; Co-op duplicate racer: prompt against its actual rider target
               ;; instead of relying on the singleton *target* display gate.
               (when (racer-try-prompt-mount! self tgt)
                 (go-virtual pickup (the-as (state collectable) (method-of-object self wait-for-return))))))))
        (racer-effect)
        (suspend))))
  :post ja-post)

(defstate pickup (racer)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('draw)
         ;; In co-op, P2's camera can bring the transpad into view while a player
         ;; is actively riding, firing 'draw and ghosting the stationary vehicle model
         ;; at the transpad. Only restore visibility when no rider is present.
         (when (zero? (-> self rider))
           (ja-channel-set! 1)
           (ja :group! racer-racer-idle-ja)
           (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
           (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
           (transform-post)))
        (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))
        (('touch 'attack) #f)
        (('shadow)
         (cond
           ((-> block param 0)
            (let ((v0-1 (the-as object (-> self shadow-backup)))) (set! (-> self draw shadow) (the-as shadow-geo v0-1)) v0-1))
           (else (set! (-> self draw shadow) #f) #f)))))
  :enter
    (behavior ((arg0 (state collectable)))
      ((the-as (function none :behavior racer) (-> arg0 enter))))
  :code
    (behavior ((arg0 (state collectable)))
      (ja-channel-set! 0)
      (ja-post)
      (let ((rider-proc (the-as target #f)))
        (when (not (zero? (-> self rider)))
          (set! rider-proc (the-as target (handle->process (-> self rider)))))
        (while (zero? (ja-group-size))
          (when (or (not rider-proc)
                    ;; Also exit if the rider has dismounted (flag cleared) so we
                    ;; don't spin here forever when the player dismounts near the transpad.
                    (not (logtest? (-> rider-proc control root-prim prim-core action) (collide-action racer)))
                    (< 24576.0 (vector-vector-distance (-> self root trans) (-> rider-proc control trans))))
            (when (and rider-proc (logtest? (-> rider-proc control root-prim prim-core action) (collide-action racer)))
              (case (-> (level-get-target-inside *level*) name)
                (('misty)
                 (close-specific-task! (game-task misty-bike) (task-status need-reminder-a))
                 (level-hint-spawn (text-id misty-bike-hint) "sksp0062" (the-as entity #f) *entity-pool* (game-task none)))))
            (go arg0))
          (racer-effect)
          (suspend))
        (while (and rider-proc (logtest? (-> rider-proc control root-prim prim-core action) (collide-action racer)))
          (racer-effect)
          (suspend)))
      (suspend-for (seconds 1)
        (racer-effect))
      (go arg0)))

(defstate wait-for-return (racer)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (when (not (zero? (-> self rider)))
        (let ((rider-proc (the-as target (handle->process (-> self rider)))))
          (when (and rider-proc
                     (!= (-> self condition) 4)
                     (= proc rider-proc)
                     (or (= message 'touch) (= message 'attack)))
            ;; Send 'end-mode to start the dismount animation, but do NOT go
            ;; to idle here. The vehicle must stay hidden until the get-off
            ;; animation completes (target-racing-start :exit fires when
            ;; entering target-racing-get-off-hit-ground, clearing the racer
            ;; collide-action and deactivating the manipy). The code loop below
            ;; detects the cleared flag and transitions to idle at that point,
            ;; preventing the ghost-at-transpad artifact.
            (send-event rider-proc 'end-mode))))
      (cond
        ((= message 'trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))
        ((= message 'shadow)
         (cond
           ((-> block param 0)
            (let ((v0-3 (the-as structure (-> self shadow-backup)))) (set! (-> self draw shadow) (the-as shadow-geo v0-3)) v0-3))
           (else (set! (-> self draw shadow) #f) #f)))))
  :enter
    (behavior ()
      (when *multi-coop-active*
        (format 0 "[VEH:racer] wait-for-return ENTER self=~A pidx=~D entity=~A rider-set=~A~%"
          self
          (-> self player-index)
          (-> self entity)
          (not (zero? (-> self rider)))))
      (blocking-plane-destroy)
      (if (and (not *allow-zoomer-anywhere*) (zero? (-> self player-index))) (blocking-plane-spawn (the-as curve-control (-> self path-racer)))) ;;mod-base-change
      ;; Re-assert the pin for the ridden state too; helper keeps the guard symmetric.
      (racer-pin-entity! self)
      (none))
  :exit
    (behavior ()
      (racer-unpin-entity! self)
      (none))
  :code
    (behavior ()
      (ja-channel-set! 0)
      (ja-post)
      (loop
        (when (not (zero? (-> self rider)))
          (let ((rider-proc (the-as target (handle->process (-> self rider)))))
            (when (or (not rider-proc) (not (logtest? (-> rider-proc control root-prim prim-core action) (collide-action racer))))
              (set! (-> self rider) (the-as handle 0))
              (go-virtual idle))))
        (racer-effect)
        (suspend))))

(defbehavior racer-init-by-other racer ((arg0 entity-actor) (arg1 float))
  (let ((s4-0 (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s3-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 0.0 6144.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> self root) s4-0))
  (process-drawable-from-entity! self arg0)
  (set-yaw-angle-clear-roll-pitch! (-> self root) (res-lump-float arg0 'rotoffset))
  (initialize-skeleton self *racer-sg* '())
  (set! (-> self shadow-backup) (-> self draw shadow))
  (set! (-> self draw shadow-ctrl) *racer-shadow-control*)
  (let ((v1-23 (-> self node-list data)))
    (set! (-> v1-23 0 param0) cspace<-transformq+trans!)
    (set! (-> v1-23 0 param1) (the-as basic (-> self root trans)))
    (set! (-> v1-23 0 param2) (the-as basic (-> self extra-trans))))
  (set! (-> self condition) (res-lump-value arg0 'index int))
  (set! (-> self fact) (new 'process 'fact-info self (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> self part) (create-launch-control group-racer-trans-pad self))
  (dotimes (s5-1 2)
    (let ((v1-32 (new 'process 'curve-control self 'path (the float (+ s5-1 1)))))
      (set! (-> self path-data s5-1) v1-32)
      (if v1-32 (logior! (-> v1-32 flags) (path-control-flag display draw-line draw-point draw-text)))))
  (set! (-> self path) (-> self path-target))
  (set-vector! (-> self extra-trans) 0.0 6144.0 0.0 1.0)
  (set! (-> self auto-get-off) #f)
  (set! (-> self entity) (the-as entity-actor #f))
  (set! (-> self rider) (the-as handle 0))
  (set! (-> self player-index) 1)
  (when *multi-coop-active*
    (format 0 "[VEH:racer] init-by-other self=~A pidx=~D entity=~A src-entity=~A xoff=~M~%"
      self
      (-> self player-index)
      (-> self entity)
      arg0
      arg1))
  (+! (-> self root trans x) arg1)
  (move-to-ground (-> self root) 40960.0 40960.0 #t (collide-kind background))
  (set! (-> self cell) (the-as handle #f))
  (set! (-> self sound) (new 'process 'ambient-sound (static-sound-spec "zoom-teleport" :fo-max 30) (-> self root trans)))
  (go (method-of-object self wait-for-start))
  (none))

(defmethod init-from-entity! ((this racer) (arg0 entity-actor))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s3-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 0.0 6144.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (process-drawable-from-entity! this arg0)
  (set-yaw-angle-clear-roll-pitch! (-> this root) (res-lump-float arg0 'rotoffset))
  (initialize-skeleton this *racer-sg* '())
  (set! (-> this shadow-backup) (-> this draw shadow))
  (set! (-> this draw shadow-ctrl) *racer-shadow-control*)
  (let ((v1-23 (-> this node-list data)))
    (set! (-> v1-23 0 param0) cspace<-transformq+trans!)
    (set! (-> v1-23 0 param1) (the-as basic (-> this root trans)))
    (set! (-> v1-23 0 param2) (the-as basic (-> this extra-trans))))
  (set! (-> this condition) (res-lump-value arg0 'index int))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this part) (create-launch-control group-racer-trans-pad this))
  (dotimes (s5-1 2)
    (let ((v1-32 (new 'process 'curve-control this 'path (the float (+ s5-1 1)))))
      (set! (-> this path-data s5-1) v1-32)
      (if v1-32 (logior! (-> v1-32 flags) (path-control-flag display draw-line draw-point draw-text)))))
  (set! (-> this path) (-> this path-target))
  (set-vector! (-> this extra-trans) 0.0 6144.0 0.0 1.0)
  (set! (-> this auto-get-off) #f)
  (set! (-> this rider) (the-as handle 0))
  (set! (-> this player-index) (if *racer-spawning-entity-copy* 1 0))
  (when *multi-coop-active*
    (format 0 "[VEH:racer] init-from-entity self=~A pidx=~D entity=~A~%"
      this
      (-> this player-index)
      (-> this entity)))
  (move-to-ground (-> this root) 40960.0 40960.0 #t (collide-kind background))
  (set! (-> this cell) (the-as handle #f))
  (if (not *allow-zoomer-anywhere*) ;;mod-base-change
    (blocking-plane-spawn (the-as curve-control
                                  (if (or (and *target* (logtest? (-> *target* control root-prim prim-core action) (collide-action racer)))
                                          (= (-> this condition) 3))
                                    (-> this path-racer)
                                    (-> this path-target)))))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "zoom-teleport" :fo-max 30) (-> this root trans)))
  (when (and *multi-coop-active* (not *racer-spawning-entity-copy*))
    ;; Birth the co-op racer through the entity initializer so its target-side
    ;; hover/collision path sees a real racer entity instead of an entityless
    ;; process clone.
    (racer-spawn-entity-copy-for-p2! arg0 (meters 6)))
  (go (method-of-object this wait-for-start))
  (none))
