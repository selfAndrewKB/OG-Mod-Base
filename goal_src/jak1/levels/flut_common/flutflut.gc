;;-*-Lisp-*-
(in-package goal)
(bundles "SNO.DGO" "SWA.DGO")
(require "levels/common/blocking-plane.gc")
(require "engine/common-obs/generic-obs.gc")
(require "engine/entity/ambient.gc")

;; DECOMP BEGINS

(define-extern *allow-flutflut-anywhere* symbol)

(if (not (nmember "flutp" *kernel-packages*)) (set! *kernel-packages* (cons "flutp" *kernel-packages*)))

(deftype flutflut (process-drawable)
  ((root            collide-shape-moving :override)
   (parent-override (pointer target) :overlay-at parent)
   (extra-trans     vector :inline)
   (condition       int32)
   (auto-get-off    symbol)
   (cell            handle)
   (path-data       path-control 2)
   (path-target     path-control :overlay-at (-> path-data 0))
   (path-flut       path-control :overlay-at (-> path-data 1))
   (touch-time      time-frame)
   (rider           handle))
  :pack-me
  (:state-methods
   wait-for-start
   idle
   (pickup (state flutflut))
   wait-for-return))


(defmethod relocate ((this flutflut) (offset int))
  (countdown (v1-0 2)
    (if (-> this path-data v1-0) (&+! (-> this path-data v1-0) offset)))
  (the-as flutflut ((method-of-type process-drawable relocate) this offset)))

(define *flutflut-shadow-control*
  (new 'static
       'shadow-control
       :settings
       (new 'static
            'shadow-settings
            :flags (shadow-flags disable-fade shdf03)
            :shadow-dir
            (new 'static 'vector :y -1.0 :w 614400.0)
            :bot-plane
            (new 'static 'plane :y 1.0 :w 81920.0)
            :top-plane
            (new 'static 'plane :y 1.0 :w -2867.2))))

(defskelgroup *flutflut-sg*
  flut-saddle
  flut-saddle-lod0-jg
  -1
  ((flut-saddle-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 3.5)
  :shadow flut-saddle-shadow-mg
  :sort 1)

(defbehavior flutflut-effect flutflut ()
  (spawn (-> self part) (-> self root trans))
  (update! (-> self sound))
  0
  (none))

(defun flutflut-pin-entity! ((f flutflut))
  (when (-> f entity)
    (logior! (-> f entity extra perm status) (entity-perm-status bit-3))))

(defun flutflut-unpin-entity! ((f flutflut))
  ;; Keep the guard symmetric with flutflut-pin-entity! so the entity lifetime
  ;; rule stays centralized instead of drifting across state enter/exit bodies.
  (when (-> f entity)
    (logclear! (-> f entity extra perm status) (entity-perm-status bit-3))))

(defun flutflut-try-prompt-mount! ((f flutflut) (tgt target))
  (let ((mounted #f))
    ;; Match racer: keep the prompt/font path out of idle so entity-pool
    ;; vehicles stay under their small stack while still using the native text
    ;; display flow for whichever target owns this mount attempt.
    (hide-hud)
    (level-hint-surpress!)
    (kill-current-level-hint '() '(sidekick voicebox) 'exit)
    (when (and (hud-hidden?) (can-grab-display-for-target? f tgt))
      (print-press-to-use-for-target tgt)
      (when (and (cpad-pressed? (-> tgt control unknown-cpad-info00 number) circle)
                 (send-event tgt 'change-mode 'flut f))
        ;; Claim immediately so another nearby flutflut cannot accept the same
        ;; button press before target-flut-start sets the action bit.
        (logior! (-> tgt control root-prim prim-core action) (collide-action flut))
        (set! (-> f rider) (process->handle tgt))
        (set! mounted #t)))
    mounted))

(defstate wait-for-start (flutflut)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))
        (('notify) (let ((v0-1 (the-as structure #t))) (set! (-> self auto-get-off) (the-as symbol v0-1)) v0-1))
        (('touch 'attack) (set-time! (-> self touch-time)) #f)))
  :exit
    (behavior ()
      (set! (-> self root root-prim prim-core action) (collide-action))
      (set! (-> self root root-prim prim-core offense) (collide-offense no-offense))
      0)
  :code
    (behavior ()
      (loop
        (let ((v1-0 (-> self condition)))
          (cond
            ((or (zero? v1-0) (= v1-0 1))
             (if (or (and (task-complete? *game-info* (game-task beach-flutflut))
                          (or (and (zero? (-> self condition)) (task-closed? (game-task village2-levitator) (task-status need-hint)))
                              (and (= (-> self condition) 1) (task-closed? (game-task village3-button) (task-status need-hint)))))
                     (and *cheat-mode* (cpad-hold? 0 l3))
                     (not (zero? (-> self rider))))
               (goto cfg-75)))
            ((= v1-0 4)
             (if (not (zero? (-> self rider))) (goto cfg-75)))
            ((= v1-0 3)
             (cond
               ((and (task-complete? *game-info* (-> self entity extra perm task))
                     (or (zero? (-> self cell)) (not (handle->process (-> self cell)))))
                (let ((rider-proc (the-as target #f)))
                  (when (not (zero? (-> self rider)))
                    (set! rider-proc (the-as target (handle->process (-> self rider)))))
                  (when (and (-> self auto-get-off) rider-proc (send-event rider-proc 'end-mode))
                    (set! (-> self rider) (the-as handle 0))
                    (set! (-> self auto-get-off) #f)
                    (go-virtual pickup (method-of-object self idle))))
                (set! (-> self auto-get-off) #f)
                (if (= (-> self condition) 3) (goto cfg-75))
                (if (and (not (zero? (-> self rider)))
                         (not (time-elapsed? (-> self touch-time) (seconds 0.05))))
                  (go-virtual pickup (method-of-object self idle))))
               ((or (zero? (-> self cell)) (not (handle->process (-> self cell))))
                (set! (-> self cell)
                      (ppointer->handle (birth-pickup-at-point (vector+! (new 'stack-no-clear 'vector) (-> self root trans) (new 'static 'vector :y 8192.0 :w 1.0))
                                                               (pickup-type fuel-cell)
                                                               (the float (-> self entity extra perm task))
                                                               #f
                                                               self
                                                               (-> self fact)))))))
            (else (goto cfg-75))))
        (flutflut-effect)
        (suspend))
      (label cfg-75)
      (if (not (zero? (-> self rider)))
        (go-virtual wait-for-return)
        (go-virtual idle))))

(defstate idle (flutflut)
  :virtual #t
  :event
    (-> (method-of-type flutflut wait-for-start)
        event)
  :enter
    (behavior ()
      (blocking-plane-destroy)
      (if (not *allow-flutflut-anywhere*) (blocking-plane-spawn (the-as curve-control (-> self path-target))))
      ;; Match racer: pin before pickup starts so actor visibility GC cannot
      ;; kill the level-authored flutflut during the mount transition.
      (flutflut-pin-entity! self)
      (none))
  :exit
    (-> (method-of-type flutflut wait-for-start)
        exit)
  :code
    (behavior ()
      (ja-channel-set! 1)
      (ja :group! flut-saddle-flut-idle-ja)
      (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
      (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
      (loop
        (when (not (zero? (-> self rider)))
          (go-virtual wait-for-return))
        (when (logtest? (-> self draw status) (draw-status was-drawn))
          (if (and *target* (>= 40960.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
            (level-hint-spawn (text-id swamp-flutflut-hint) "sksp0160" (the-as entity #f) *entity-pool* (game-task none))))
        (let ((nearest-tgt (the-as target #f))
              (nearest-dist (the float #x7fffffff)))
          (dotimes (idx (-> *target-list* length))
            (let ((tgt (get-target idx)))
              (when (and tgt
                         (not (logtest? (-> tgt control root-prim prim-core action) (collide-action flut))))
                (let ((d (vector-vector-distance (-> self root trans) (-> tgt control trans))))
                  (when (and (>= 20480.0 d) (< d nearest-dist))
                    (set! nearest-dist d)
                    (set! nearest-tgt tgt))))))
          (when (and nearest-tgt
                     (not (movie?))
                     (not (level-hint-displayed?))
                     (!= (-> self condition) 4))
            (when (flutflut-try-prompt-mount! self nearest-tgt)
              (go-virtual pickup (method-of-object self wait-for-return)))))
        (flutflut-effect)
        (suspend)
        (ja :num! (loop!))))
  :post ja-post)

(defstate pickup (flutflut)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('draw)
         ;; In co-op, P2's camera can bring the transpad into view while a player is
         ;; actively riding, firing 'draw and ghosting the stationary vehicle model.
         ;; Only restore visibility when no rider is present (return-to-pad path).
         (when (zero? (-> self rider))
           (ja-channel-set! 1)
           (ja :group! flut-saddle-flut-idle-ja)
           (set! (-> self root root-prim prim-core action) (collide-action solid attackable-unused))
           (set! (-> self root root-prim prim-core offense) (collide-offense indestructible))
           (transform-post)))
        (('trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans)))
        (('touch 'attack) #f)))
  :enter
    (behavior ((arg0 (state flutflut)))
      ((-> arg0 enter)))
  :code
    (behavior ((arg0 (state flutflut)))
      (ja-channel-set! 0)
      (ja-post)
      (while (zero? (ja-group-size))
        (let ((rp (the-as target #f)))
          (when (not (zero? (-> self rider)))
            (set! rp (the-as target (handle->process (-> self rider)))))
          ;; Also exit if the rider has already dismounted (flag cleared) so we
          ;; don't spin here forever when the player dismounts near the transpad.
          (if (or (not rp)
                  (not (logtest? (-> rp control root-prim prim-core action) (collide-action flut)))
                  (< 24576.0 (vector-vector-distance (-> self root trans) (-> rp control trans))))
            (go arg0)))
        (flutflut-effect)
        (suspend))
      (while (let ((rp (the-as target #f)))
               (when (not (zero? (-> self rider)))
                 (set! rp (the-as target (handle->process (-> self rider)))))
               (and rp (logtest? (-> rp control root-prim prim-core action) (collide-action flut))))
        (flutflut-effect)
        (suspend))
      (suspend-for (seconds 1)
        (flutflut-effect))
      (go arg0)))

(defstate wait-for-return (flutflut)
  :virtual #t
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      ;; guard: a second touch event can fire before the state transitions away (rider already 0)
      ;; for 'touch: only the rider themselves can trigger forced dismount - other targets
      ;; walking near the flutflut must not eject the rider.
      ;; for 'attack: any sender can eject (enemies hitting the flutflut).
      (when (not (zero? (-> self rider)))
        (let ((rider-proc (the-as target (handle->process (-> self rider)))))
          (when (and rider-proc
                     (or (and (= message 'touch) (= proc rider-proc))
                         (= message 'attack)))
            ;; Send 'end-mode to start the dismount animation, but do NOT go
            ;; to idle here. The vehicle stays hidden until the get-off
            ;; animation completes (target-flut-start :exit fires when leaving
            ;; the get-off state group, clearing collide-action flut and
            ;; deactivating the manipy). The code loop detects the cleared
            ;; flag and transitions to idle at that point.
            (send-event rider-proc 'end-mode))))
      (if (= message 'trans) (vector+! (the-as vector (-> block param 0)) (-> self root trans) (-> self extra-trans))))
  :enter
    (behavior ()
      (blocking-plane-destroy)
      (if (not *allow-flutflut-anywhere*) (blocking-plane-spawn (the-as curve-control (-> self path-flut))))
      (flutflut-pin-entity! self)
      (none))
  :exit
    (behavior ()
      (flutflut-unpin-entity! self)
      (none))
  :code
    (behavior ()
      (ja-channel-set! 0)
      (ja-post)
      (loop
        (let ((rider-proc (the-as target #f)))
          (when (not (zero? (-> self rider)))
            (set! rider-proc (the-as target (handle->process (-> self rider)))))
          (when (or (not rider-proc) (not (logtest? (-> rider-proc control root-prim prim-core action) (collide-action flut))))
            (set! (-> self rider) (the-as handle 0))
            (go-virtual idle)))
        (flutflut-effect)
        (suspend))))

;; Co-op duplicate: same setup as init-from-entity! but with an x-offset applied before
;; move-to-ground, and without the co-op spawn block (to prevent infinite recursion).
(defbehavior flutflut-init-by-other flutflut ((arg0 entity-actor) (arg1 float))
  (let ((s4-0 (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s3-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set-vector! (-> s3-0 local-sphere) 0.0 6144.0 0.0 6144.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> self root) s4-0))
  (process-drawable-from-entity! self arg0)
  (set-yaw-angle-clear-roll-pitch! (-> self root) (res-lump-float arg0 'rotoffset))
  (initialize-skeleton self *flutflut-sg* '())
  (logior! (-> self skel status) (janim-status eye))
  (set! (-> self draw shadow-ctrl) *flutflut-shadow-control*)
  (let ((v1-24 (-> self node-list data)))
    (set! (-> v1-24 0 param0) cspace<-transformq+trans!)
    (set! (-> v1-24 0 param1) (the-as basic (-> self root trans)))
    (set! (-> v1-24 0 param2) (the-as basic (-> self extra-trans))))
  (dotimes (s4-2 2)
    (let ((v1-27 (new 'process 'curve-control self 'path (the float (+ s4-2 1)))))
      (set! (-> self path-data s4-2) v1-27)
      (if v1-27 (logior! (-> v1-27 flags) (path-control-flag display draw-line draw-point draw-text)))))
  (set! (-> self condition) (res-lump-value arg0 'index int))
  (set! (-> self fact) (new 'process 'fact-info self (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> self part) (create-launch-control group-flut-trans-pad self))
  (set! (-> self auto-get-off) #f)
  (set! (-> self entity) (the-as entity-actor #f))
  (set! (-> self rider) (the-as handle 0))
  (+! (-> self root trans x) arg1)
  (move-to-ground (-> self root) 40960.0 40960.0 #t (collide-kind background))
  (set! (-> self cell) (the-as handle #f))
  (if (not *allow-flutflut-anywhere*)
    (blocking-plane-spawn (the-as curve-control (-> self path-target))))
  (set! (-> self sound) (new 'process 'ambient-sound (static-sound-spec "zoom-teleport" :fo-max 30) (-> self root trans)))
  (go (method-of-object self wait-for-start))
  (none))

(defmethod init-from-entity! ((this flutflut) (arg0 entity-actor))
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) default-collision-reaction)
    (set! (-> s4-0 no-reaction) (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((s3-0 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set-vector! (-> s3-0 local-sphere) 0.0 6144.0 0.0 6144.0)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (process-drawable-from-entity! this arg0)
  (set-yaw-angle-clear-roll-pitch! (-> this root) (res-lump-float arg0 'rotoffset))
  (initialize-skeleton this *flutflut-sg* '())
  (logior! (-> this skel status) (janim-status eye))
  (set! (-> this draw shadow-ctrl) *flutflut-shadow-control*)
  (let ((v1-24 (-> this node-list data)))
    (set! (-> v1-24 0 param0) cspace<-transformq+trans!)
    (set! (-> v1-24 0 param1) (the-as basic (-> this root trans)))
    (set! (-> v1-24 0 param2) (the-as basic (-> this extra-trans))))
  (dotimes (s4-2 2)
    (let ((v1-27 (new 'process 'curve-control this 'path (the float (+ s4-2 1)))))
      (set! (-> this path-data s4-2) v1-27)
      (if v1-27 (logior! (-> v1-27 flags) (path-control-flag display draw-line draw-point draw-text)))))
  (set! (-> this condition) (res-lump-value arg0 'index int))
  (set! (-> this fact) (new 'process 'fact-info this (pickup-type eco-pill-random) (-> *FACT-bank* default-pill-inc)))
  (set! (-> this part) (create-launch-control group-flut-trans-pad this))
  (set! (-> this auto-get-off) #f)
  (set! (-> this rider) (the-as handle 0))
  (move-to-ground (-> this root) 40960.0 40960.0 #t (collide-kind background))
  (set! (-> this cell) (the-as handle #f))
  (if (not *allow-flutflut-anywhere*)
    (blocking-plane-spawn (the-as curve-control (-> this path-target))))
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "zoom-teleport" :fo-max 30) (-> this root trans)))
  (when *multi-coop-active*
    (process-spawn flutflut :init flutflut-init-by-other arg0 (meters 2.5) :to *entity-pool*))
  (go (method-of-object this wait-for-start))
  (none))
